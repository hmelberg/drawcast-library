    sort: desc
    value_labels: true
    bar_colors: same
    ylim:
      - 0
      - 10
    y_label: Most they'd pay ($)
    icons:
      - woman
      - man
      - woman
      - man
    reference:
      - {value: 6.5, label: Price $6.50, color: red}
      - {value: 4.5, label: Price $4.50, color: red}
