    text bhag "Bhagwati & Ramaswami, 1963" #8f887c cites ["bhagwati1963"] x 500 y 520 font_size 26 hidden true
    icon car size 110 x 280 y 390 or ["automobile"] icon_look picture of car hidden true
    text toll "road toll:\nfixes the jam" #2f6b8f x 280 y 280 font_size 32 hidden true
    icon bus size 110 x 720 y 390 icon_look picture of bus hidden true
    text sub "bus subsidy:\nclaws back part" #8f887c x 720 y 280 font_size 32 hidden true
    text q "How sure are we?" #3d3833 x 500 y 590 font_size 40 hidden true
    text r1 "the theorem" x 330 y 500 font_size 34 hidden true
    text w1 "consensus" #4f8a3a x 740 y 500 font_size 36 hidden true
    text r2 "big transit subsidies can pay" cites ["parry2009"] x 330 y 410 font_size 34 hidden true
    text w2 "mostly agreed" #2f6b8f cites ["parry2009"] x 740 y 410 font_size 36 hidden true
    text r3 "how strong the links are" x 330 y 320 font_size 34 hidden true
