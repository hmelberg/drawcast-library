    path reef #3d3833 points [[590,330],[610,375],[628,345],[646,392],[664,352],[682,385],[700,335]] style.stroke_width 4 hidden true
    label reef_lab "reef" below attach_to reef hidden true
    icon wreck size 56 x 646 y 425 icon_look picture of sailboat hidden true
    icon boat_1 size 80 x 90 y 305 icon_look picture of sailboat hidden true
    icon boat_2 size 80 x 205 y 305 icon_look picture of sailboat hidden true
    icon boat_3 size 80 x 320 y 305 icon_look picture of sailboat hidden true
    icon boat_4 size 80 x 435 y 305 icon_look picture of sailboat hidden true
    icon boat_5 size 80 x 550 y 305 icon_look picture of sailboat hidden true
