    shape bar2 #2f6b8f shape rect x 440 y 349 width 180 height 198 bind.height 3.3*V2 bind.y "250 + 3.3*V2/2" style.fill #2f6b8f style.opacity 0.8 hidden true
    text val2 "${V2:0}" x 440 y 520 font_size 44 bind.y "250 + 3.3*V2 + 30" hidden true
