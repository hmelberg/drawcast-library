    text hr "Camerer" #2f6b8f cites ["camerer2015"] x 750 y 620 font_size 36 hidden true
    text r1 "tests principles,\nnot levels" #3d3833 cites ["camerer2015"] x 750 y 535 font_size 32 hidden true
    text r2 "close matches agree" #3d3833 cites ["camerer2015"] x 750 y 445 font_size 32 hidden true
    text labdg "lab dictator game" #8f887c cites ["franzen2013"] x 160 y 320 font_size 26 hidden true
