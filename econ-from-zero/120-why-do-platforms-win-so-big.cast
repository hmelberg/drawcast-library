      expr: 100/(1+exp(-(2*n*(1-m/100)*(2*s4/100-1))))
    s6:
      expr: 100/(1+exp(-(2*n*(1-m/100)*(2*s5/100-1))))
    s7:
      expr: 100/(1+exp(-(2*n*(1-m/100)*(2*s6/100-1))))
    s8:
      expr: 100/(1+exp(-(2*n*(1-m/100)*(2*s7/100-1))))
    s9:
      expr: 100/(1+exp(-(2*n*(1-m/100)*(2*s8/100-1))))
    s10:
      expr: 100/(1+exp(-(2*n*(1-m/100)*(2*s9/100-1))))
sources:
    - id: secondmeasure
      title: 'Uber vs. Lyft: Who''s tops in the battle of U.S. rideshare companies'
      authors: Bloomberg Second Measure
      year: 2024
      finding: In March 2024 Uber accounted for 76 percent of observed U.S. rideshare spending (card data).
      url: https://secondmeasure.com/datapoints/rideshare-industry-overview/
    - id: comscore
      title: Social Networking Explodes Worldwide as Sites Increase their Focus on Cultural Relevance
      authors: comScore
      year: 2008
      finding: Facebook took over the global lead among social networking sites from MySpace in April 2008, measured by worldwide unique visitors.
      url: https://www.comscore.com/Insights/Press-Releases/2008/08/Social-Networking-World-Wide
    - id: zhu2019
      title: Why Some Platforms Thrive and Others Don't
      authors: Feng Zhu and Marco Iansiti
      year: 2019
      finding: 'Harvard Business Review 97(1): a platform''s strength depends on its network''s properties — network effects, clustering into local markets, multi-homing, disintermediation and bridging — not on scale alone.'

    axes ax x_label Round y_label "HarbourPay's share of payments (%)" ticks.x [0,2,4,6,8] ticks.y [0,25,50,75,100] hidden true
