    icon harbour size 80 x 90 y 150 or ["house"] icon_look picture of lighthouse hidden true
    text town "Harbourtown" x 215 y 125 font_size 32 hidden true
    icon boat1 size 56 or ["boat","motor boat"] icon_look picture of sailboat in fleet hidden true
    icon boat2 size 56 or ["boat","motor boat"] icon_look picture of sailboat in fleet hidden true
    icon boat3 size 56 or ["boat","motor boat"] icon_look picture of sailboat in fleet hidden true
