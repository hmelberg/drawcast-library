sources:
    - id: fao
      title: Status of the world's fish stocks (SDG 14.4.1), via Our World in Data
      authors: FAO; Our World in Data
      year: 2025
      finding: 'Share of assessed fish stocks overexploited: 10% in 1974, 35.5% in 2021.'
      url: https://ourworldindata.org/grapher/fish-stocks-within-sustainable-levels
    - id: hardin68
      title: The Tragedy of the Commons
      authors: Garrett Hardin
      year: 1968
      finding: 'Herders on a shared pasture each gain the whole of an extra animal but bear only a share of the overgrazing: ''Freedom in a commons brings ruin to all.'''
      doi: 10.1126/science.162.3859.1243

    text t1974 "1974: 10%" #2f6b8f at.data [1979,17] font_size 34 hidden true
    text t2021 "2021: 35.5%" #b5482e at.data [2012,42] cites ["fao"] font_size 40 hidden true
    path sea smooth closed #2f6b8f points [[70,200],[180,170],[400,185],[600,175],[640,300],[630,470],[600,590],[380,610],[160,600],[60,480],[50,320]] style.fill #d6e6ef hidden true
