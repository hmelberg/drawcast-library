    shape barD #87a878 shape rect x 430 y 360 width 100 height 1 bind.height max(1,6*min(D,35)) bind.y 360+(6*min(D,35))/2 style.fill #87a878 style.opacity 0.85 style.stroke_width 0 hidden true
    shape barRp #2f6b8f shape rect x 600 y 360 width 100 height 1 bind.height max(1,6*min(max(R,0),35)) bind.y 360+(6*min(max(R,0),35))/2 style.fill #2f6b8f style.opacity 0.85 style.stroke_width 0 hidden true
    shape barRn #b5482e shape rect x 600 y 360 width 100 height 1 bind.height max(1,6*min(max(-R,0),35)) bind.y 360-(6*min(max(-R,0),35))/2 style.fill #b5482e style.opacity 0.85 style.stroke_width 0 hidden true
