    path flip #b5482e points [[500,420],[500,465]] style.stroke_width 4 hidden true
    text fliplab "1: flip point for savers" #b5482e x 610 y 335 font_size 32 hidden true
    text mean "reported mean ≈ 0.5" cites ["havranek2015jie","havranek2015jeea"] x 305 y 560 font_size 32 hidden true
    path band #e0a800 points [[255,420],[290,420]] style.stroke_width 16 hidden true
