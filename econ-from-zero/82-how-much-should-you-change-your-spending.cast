    ```brython sim x 835 y 440 width 300 font_size 28 show code controls ["r","sigma","savings"] pane controls hidden true
    r = Slider(0, 4, step=0.5, default=2, label="interest rate r, %")
    sigma = Slider(0.1, 2, step=0.1, default=0.5, label="sigma: willing to shift")
    savings = Slider(0, 100, step=10, default=100, label="savings now, %")
    T = 30
    delta = 1 / 1.02
    prof = [20 + 40 * t / (T - 1) for t in range(T)]
    pv = sum(p / 1.02 ** t for t, p in enumerate(prof))
    def plan(rr):
        A = savings / 100 * 600
        y = [(1 - savings / 100) * 600 * p / pv for p in prof]
        W = A + sum(y[t] / (1 + rr) ** t for t in range(T))
        g = (delta * (1 + rr)) ** sigma
        c0 = W / sum((g / (1 + rr)) ** t for t in range(T))
        return [round(c0 * g ** t, 2) for t in range(T)]
    new = plan(r / 100)
    old = plan(0.02)
    c0 = round(new[0], 1)
    pct = round(100 * (new[0] / old[0] - 1), 1)
    sign = "+" if pct > 0 else ""
    ```
