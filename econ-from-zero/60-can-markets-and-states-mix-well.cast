    text end_m "market" #3d3833 x 110 y 521 font_size 34 hidden true
    text end_s "state" #3d3833 x 890 y 521 font_size 34 hidden true
    scale rules cites ["oecdpmr"] x 150 y 275 width 560 font_size 28 min 1 max 56 value 1 ticks 5 markers [{"value":8,"label":"Finland, Norway, Denmark 7–9","color":"#2f6b8f"},{"value":34,"label":"US 34","color":"#b5482e"},{"value":1,"label":"Sweden 1","color":"#2f6b8f"}] hidden true
