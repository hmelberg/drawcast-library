    text kvw "Kaplan, Violante\n& Weidner 2014" #8f887c cites ["kvw2014"] x 790 y 470 font_size 28 hidden true
    box locked "House or pension\n~$50,000 at 40\nCash: almost none" cites ["kvw2014"] x 790 y 330 width 340 height 230 radius 12 icon house font_size 32 style.stroke #d9a521 hidden true
    icon lock size 70 set twemoji x 940 y 430 icon_look picture of locked hidden true
    text rd_title "Spent in 3 months,\nper $1 (illustrative)" #8f887c x 790 y 480 font_size 28 hidden true
    text rd_htm "hand to mouth: {m}¢" #b5482e x 790 y 400 font_size 30 hidden true
    text rd_sm "smoothers: 1¢" x 790 y 350 font_size 30 hidden true
