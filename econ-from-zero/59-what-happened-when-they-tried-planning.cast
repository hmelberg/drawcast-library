    text t28 "1928: 19%" #2f6b8f at.data [1936,12] cites ["maddison2023"] font_size 30 hidden true
    text plan "1st five-year plan" #8f887c at.data [1940,6] font_size 28 hidden true
    text t50 "1950: 30%" #2f6b8f at.data [1953,20] font_size 28 hidden true
    text t75 "1975: 38%" #2f6b8f at.data [1966,44] font_size 34 hidden true
