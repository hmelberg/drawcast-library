    text samq "1961 textbook:\novertake\nby 1984?" #8a5fa8 cites ["levypeart2011"] x 880 y 260 font_size 30 hidden true
    text t89 "1989: 31%" #b5482e at.data [1982,24] font_size 34 hidden true
