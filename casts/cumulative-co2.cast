role: thumbnail

    icon loco size 280 set twemoji x 300 y 430 icon_look picture of locomotive hidden true
    text y "1850" #2f2b26 x 720 y 520 font_size 140 hidden true
    text p "who led?" #b5482e x 720 y 360 font_size 80 hidden true
    thumb band "Rewind the CO2 clock" kind band hidden true

## Thumbnail
role: thumbnail

    icon fac size 260 set twemoji x 500 y 470 icon_look picture of factory hidden true
    text c "China? USA? UK?" #b5482e x 500 y 260 font_size 64 hidden true
    thumb band "Most CO2 ever?" kind question hidden true
