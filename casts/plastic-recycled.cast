    text n9 "9" above s9 gap 12 #2f6b8f cites ["fate","faq"] font_size 56 hidden true
    text n1 "1" above s1 gap 12 #b5482e cites ["fate","faq"] font_size 56 hidden true
    text w100 "thrown out" below s100 gap 12 #8f887c font_size 48 hidden true
    text w9 "recycled" below s9 gap 12 #2f6b8f cites ["fate","faq"] font_size 48 hidden true
