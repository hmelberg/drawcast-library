role: thumbnail

    icon brick size 220 set twemoji x 300 y 470 icon_look picture of "telephone receiver" hidden true
    text y "1990" #5e584e x 300 y 300 font_size 80 hidden true
    icon ph size 220 set twemoji x 720 y 470 icon_look picture of "mobile phone" hidden true
    text y2 "today" #5e584e x 720 y 300 font_size 80 hidden true
    thumb st "3 claims" kind stamp x 510 y 620 angle -6 hidden true
    thumb b "Phones vs people" kind band hidden true
