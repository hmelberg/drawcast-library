    text gt "?" #b5482e x 520 y 440 font_size 160 hidden true
    icon pp size 260 set twemoji x 750 y 430 icon_look picture of "people holding hands" hidden true
    thumb st "TRUE OR MYTH?" kind stamp x 500 y 220 angle 6 hidden true

