    text tv "8 corners" #b5482e x 760 y 600 font_size 42 hidden true
    text te "12 edges" #3d3833 x 760 y 525 font_size 42 hidden true
    text tf "6 faces" #2f6b8f x 760 y 450 font_size 42 hidden true
    text sum_c "8 − 12 + 6 = 2" #b5482e x 750 y 360 font_size 52 hidden true
    text sum_p "5 − 8 + 5 = 2" #b5482e x 750 y 390 font_size 52 hidden true
    text ball "football: 60 − 90 + 32" #2f6b8f x 740 y 305 font_size 32 hidden true
    text eul "Euler, 1750" #2f6b8f cites ["euler"] x 750 y 500 font_size 40 hidden true
