    path fr_c2 points [[380,480],[440,530]] style.stroke_width 4 hidden true
    path fr_c3 points [[380,220],[440,270]] style.stroke_width 4 hidden true
    path fr_h points [[190,290],[250,340],[310,340]] style.stroke_width 4 hidden true
    path fr_h2 points [[250,340],[250,410]] style.stroke_width 4 hidden true
    group frame members ["fr_out","fr_in","fr_back","fr_c1","fr_c2","fr_c3","fr_h","fr_h2"] hidden true
    text zero "V − E + F = 0" #b5482e x 740 y 440 font_size 56 hidden true
    text topo "→ topology" #2f6b8f x 740 y 350 font_size 40 hidden true
