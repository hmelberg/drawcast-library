role: thumbnail

    icon globe size 300 set twemoji x 260 y 440 icon_look picture of "globe showing americas" hidden true
    text a "60,000?" #b5482e x 700 y 560 font_size 72 hidden true
    text b1 "30,000?" #d0865f x 700 y 450 font_size 72 hidden true
    text c "12,000?" #2f6b8f x 700 y 340 font_size 72 hidden true
    thumb b "How many warheads today?" kind band hidden true

## Thumbnail
role: thumbnail

    path ax #3d3833 points [[300,600],[300,180],[720,180]] style.stroke_width 4 hidden true
    path up smooth #b5482e points [[305,185],[390,290],[460,450],[520,540]] style.stroke_width 9 hidden true
    text peak "70,000" #b5482e x 520 y 600 font_size 56 hidden true
    thumb qm "?" kind star x 880 y 330 hidden true
    thumb b "Draw the rest" kind question hidden true
