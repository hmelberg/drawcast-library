    box r2_species "cat" width 130 height 62 font_size 28 in tbl hidden true
    box r2_age "3" width 130 height 62 font_size 28 in tbl hidden true
    box r2_owner "Ben" width 130 height 62 font_size 28 in tbl hidden true
