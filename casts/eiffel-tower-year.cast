    path deck1 points [[341,380],[491,380]] style.stroke_width 5 hidden true
    path deck2 points [[378,480],[454,480]] style.stroke_width 5 hidden true
    path deck3 points [[404,600],[428,600]] style.stroke_width 4 hidden true
    path mast thick points [[416,630],[416,660]] hidden true
    group tower members ["leg_l","leg_r","arch","deck1","deck2","deck3","mast"] hidden true
