    text h300 "300 m" #2f6b8f x 170 y 470 font_size 44 hidden true
    text ugly "1887: \"monstrous\"" #b5482e cites ["hist"] x 790 y 610 font_size 36 hidden true
    text permit "permit ends 1909" #b5482e cites ["te"] x 790 y 530 font_size 40 hidden true
    text radio "saved by radio" #2f6b8f cites ["te"] x 790 y 455 font_size 40 hidden true
