    text h300 "300 m" #2f6b8f x 190 y 495 font_size 44 hidden true
    text ugly "1887: \"monstrous\"" #b5482e cites ["hist"] x 780 y 535 font_size 32 hidden true
    text permit "permit to 1909" #b5482e cites ["te"] x 790 y 460 font_size 34 hidden true
    text radio "saved by radio" #2f6b8f cites ["te"] x 790 y 385 font_size 34 hidden true
