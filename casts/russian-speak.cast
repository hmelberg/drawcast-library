    text g_ya "I speak" #8f887c x 790 y 575 font_size 36 hidden true
    text p_ty "ты" #2f6b8f say ты x 240 y 470 font_size 56 hidden true
    text v_ty "говори́шь" #3d3833 say "ты говоришь" colors {"ишь$":"#3d8a5a"} x 500 y 470 font_size 70 hidden true
