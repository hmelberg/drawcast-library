    path ax #2f2b26 points [[120,640],[120,230],[900,230]] style.stroke_width 4 hidden true
    path ln #b5482e points [[130,580],[230,560],[330,510]] style.stroke_width 9 hidden true
    path g2 dashed #8f887c points [[330,510],[860,270]] style.stroke_width 4 hidden true
    path g1 dashed #8f887c points [[330,510],[840,500]] style.stroke_width 4 hidden true
    path g0 dashed #8f887c points [[330,510],[820,610]] style.stroke_width 4 hidden true
    text a "1980" #b5482e x 180 y 630 font_size 56 hidden true
    text q "?" #b5482e x 900 y 420 font_size 200 hidden true
    thumb band "Where did it go?" kind band hidden true

## Thumbnail
role: thumbnail

    text n "1,400,000" #b5482e x 500 y 500 font_size 150 hidden true
    text y "measles deaths, 1980" #2f2b26 x 500 y 380 font_size 56 hidden true
    text now "Today: ?" #2f6b8f x 500 y 260 font_size 90 hidden true
    thumb st "GUESS" kind stamp x 850 y 640 angle 10 hidden true

## Thumbnail
role: thumbnail

    icon syr size 280 set twemoji x 260 y 440 icon_look picture of syringe hidden true
    text t "Gone for good?" #2f2b26 x 690 y 470 font_size 96 hidden true
    thumb band "The line that turned" kind band hidden true
