    arrow e_unprov g_box -> n_unprov hidden true
    box n_false "Proves a falsehood" #b5482e x 250 y 230 width 340 height 95 font_size 34 hidden true
    box n_true "G is true" #2f6b8f x 750 y 230 width 280 height 95 font_size 34 hidden true
