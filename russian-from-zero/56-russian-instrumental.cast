    glossed ex2 "Мой па́па был учи́телем." say_voice b gloss ["","","","a teacher"] show_gloss under colors {"ем$":"#8a5fa8"} x 500 y 380 font_size 60 hidden true
    text ref36 "чай → с ча́ем  (lesson 36)" say "чай, с ча́ем" colors {"ем$":"#8a5fa8"} x 500 y 230 font_size 44 hidden true
    text kem "кто → кем" say "кто, кем" x 500 y 230 font_size 52 hidden true
    glossed s1 "Я рабо́таю врачо́м." say_voice b gloss ["","","as a doctor"] show_gloss under colors {"ом$":"#2f6b8f"} x 540 y 500 font_size 72 hidden true
    text ref38 "врач  ·  к врачу́  (lesson 38)" say "врач, к врачу́" x 540 y 330 font_size 40 hidden true
