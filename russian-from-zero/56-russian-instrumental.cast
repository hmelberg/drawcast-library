    icon r_cook size 110 set twemoji x 250 y 400 or ["cook"] icon_look picture of "man cook" hidden true
    text t_cook "по́вар → по́варом" say "по́вар, по́варом" colors {"ом$":"#2f6b8f"} x 600 y 400 font_size 48 hidden true
