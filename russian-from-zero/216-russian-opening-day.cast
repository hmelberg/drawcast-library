    dialogue talk speakers.a tom speakers.b np turns [{"by":"a","text":"Ни́на Петро́вна, входи́те! Сади́тесь!","gloss":"Nina Petrovna, come in! Sit down!","new":["входи́те"]},{"by":"b","text":"Спаси́бо, Том. Я пришла́ с Ве́рой, а за на́ми — пя́теро сосе́дей!","gloss":"Thank you, Tom. I came with Vera, and five neighbours behind us!"},{"by":"a","text":"Вот ваш пиро́г, по реце́пту ва́шей ма́мы.","gloss":"Here's your pie, from your mum's recipe."},{"by":"b","text":"Вы мне неде́лю приноси́ли суп, а тепе́рь — пиро́г!","gloss":"For a week you brought me soup, and now a pie!"},{"by":"a","text":"Как вам пиро́г?","gloss":"How do you like the pie?"},{"by":"b","text":"Как у ма́мы. Он бу́дет популя́рным, то́чно.","gloss":"Just like my mum's. It will be popular, for sure."},{"by":"a","text":"Спаси́бо! Береги́те себя́: на у́лице хо́лодно.","gloss":"Thank you! Take care of yourself: it's cold outside."},{"by":"b","text":"Спаси́бо, Том. До за́втра!","gloss":"Thank you, Tom. See you tomorrow!"}] show_gloss false practice true size 1.35 hidden true
    text e1 "улыба́ясь — at the same time" say "улыба́ясь — at the same time" new ["улыба́ясь"] colors {"^улыба́ясь$":"#2a7f86"} x 500 y 520 font_size 44 hidden true
