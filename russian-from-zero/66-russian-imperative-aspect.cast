    dialogue talk speakers.a tom speakers.b masha turns [{"by":"a","text":"Ма́ша, я иду́ домо́й. Пока́!","gloss":"Masha, I'm going home. Bye!"},{"by":"b","text":"Пока́! Не забу́дь кни́гу!","gloss":"Bye! Don't forget the book!"},{"by":"a","text":"Спаси́бо! Я прочита́ю её за́втра.","gloss":"Thanks! I'll read it tomorrow."},{"by":"b","text":"Прочита́й и напиши мне!","gloss":"Read it and write to me!"},{"by":"a","text":"Напишу́! А ты приходи в суббо́ту. Дава́й посмо́трим фильм!","gloss":"I will! And you come over on Saturday. Let's watch a film!"},{"by":"b","text":"Хорошо́! Позвони мне в пя́тницу.","gloss":"Good! Call me on Friday."}] practice true size 1.5 hidden true
