    dialogue talk speakers.a tom speakers.b masha turns [{"by":"a","text":"Алло́! Э́то но́мер пять. У меня́ не рабо́тает душ.","gloss":"Hello! This is room five. My shower doesn't work."},{"by":"b","text":"Ой, извини́те! Я сейча́с посмотрю́.","gloss":"Oh, I'm sorry! I'll look right away."},{"by":"a","text":"Ничего́ не рабо́тает! И вас пло́хо слы́шно.","gloss":"Nothing works! And I can hardly hear you."},{"by":"b","text":"Но́мер семь свобо́ден. Но э́то но́мер на двои́х.","gloss":"Room seven is free. But it's a room for two."},{"by":"a","text":"Ничего́! А когда́ за́втрак?","gloss":"That's fine! And when is breakfast?"},{"by":"b","text":"За́втрак в во́семь часо́в.","gloss":"Breakfast is at eight."},{"by":"a","text":"Хорошо́! Я сейча́с приду́.","gloss":"Good! I'll come right away."},{"by":"b","text":"Ваш ключ гото́в. Но́мер семь!","gloss":"Your key is ready. Room seven!"}] show_gloss false practice true size 1.3 hidden true
