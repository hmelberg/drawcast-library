    dialogue talk speakers.a tom speakers.b masha turns [{"by":"a","text":"Ма́ша, како́е сего́дня число́?","gloss":"Masha, what's the date today?"},{"by":"b","text":"Тридца́тое апре́ля.","gloss":"The thirtieth of April."},{"by":"a","text":"А за́втра пе́рвое ма́я!","gloss":"So tomorrow is the first of May!"},{"by":"b","text":"Да, пра́здник! А когда́ у тебя́ день рожде́ния?","gloss":"Yes, a holiday! And when is your birthday?"},{"by":"a","text":"В январе́, зимо́й. А у тебя́?","gloss":"In January, in winter. And yours?"},{"by":"b","text":"В а́вгусте, ле́том.","gloss":"In August, in summer."}] practice true size 1.3 hidden true
