    dialogue talk speakers.a tom speakers.b host turns [{"by":"b","text":"Ита́к, Том, како́е ва́ше люби́мое блю́до?","gloss":"So, Tom, what's your favourite dish?","new":["Ита́к","блю́до"]},{"by":"a","text":"Ку́рица с гриба́ми.","gloss":"Chicken with mushrooms.","new":["Ку́рица"]},{"by":"b","text":"А секре́т есть?","gloss":"And is there a secret?","new":["секре́т"]},{"by":"a","text":"Есть. Впро́чем, я его́ не скажу́!","gloss":"There is. Mind you, I won't tell it!","new":["Впро́чем"]},{"by":"b","text":"Вы предпочита́ете гото́вить до́ма и́ли в рестора́не?","gloss":"Do you prefer to cook at home or in the restaurant?","new":["предпочита́ете"]},{"by":"a","text":"В о́бщем, в рестора́не. Там моя́ кома́нда.","gloss":"All in all, in the restaurant. My team is there.","new":["о́бщем"]},{"by":"b","text":"Зри́тели спра́шивают: како́й ваш родно́й го́род?","gloss":"The viewers are asking: what's your home town?"},{"by":"a","text":"Ло́ндон. А мой дом тепе́рь и́менно здесь, в Петербу́рге.","gloss":"London. But my home now is right here, in Petersburg.","new":["и́менно"]}] show_gloss false practice true size 1.35 colors {"итак":"#b5532b","впрочем":"#b5532b","короче":"#b5532b","в общем":"#b5532b","именно":"#b5532b","как раз":"#b5532b"} hidden true
