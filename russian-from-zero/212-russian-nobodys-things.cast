    text lb "кто́-либо · что́-либо · како́й-либо · где́-либо" say "кто́-либо · что́-либо · како́й-либо · где́-либо" new ["где́-либо","како́й-либо","кто́-либо","что́-либо"] colors {"либо$":"#9c7a16"} x 500 y 160 font_size 40 hidden true
    text w1 "прове́рка · нару́шение · штраф" say "прове́рка · нару́шение · штраф" new ["нару́шение","прове́рка","штраф"] x 500 y 560 font_size 46 hidden true
    text w1g "an inspection · a breach · a fine" #8f887c x 500 y 500 font_size 28 hidden true
