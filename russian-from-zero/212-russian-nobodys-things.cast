    text w4g "gloves protect · no animals at all (живо́тное: an animal)" #8f887c x 500 y 65 font_size 28 hidden true
    table drill say true new ["перча́тки","нару́шит","штраф"] colors {"^ни":"#2f6b8f","либо$":"#9c7a16"} x 500 y 420 font_size 44 rows [["Чьи э́то перча́тки? — [Ничьи́]{Ничьи́,Ничто́,Никто́}."],["[Ничто́]{Ничто́,Ничьи́,Никого́} не помеша́ет нам откры́ться."],["Инспе́ктор [ничего́]{ничего́,ничто́,ничьи́} не нашла́."],["Е́сли [кто́-либо]{кто́-либо,никто́,ничто́} нару́шит пра́вила, бу́дет штраф."]] hidden true
