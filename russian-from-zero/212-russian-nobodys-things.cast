    text n3 "На ку́хне не должно́ быть ничьи́х веще́й." say "На ку́хне не должно́ быть ничьи́х веще́й." new ["ничьи́х"] colors {"^ни":"#2f6b8f"} x 500 y 230 width 920 font_size 46 hidden true
