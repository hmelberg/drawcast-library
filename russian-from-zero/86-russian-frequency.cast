    dialogue talk speakers.a tom speakers.b masha turns [{"by":"b","text":"Том, ты ча́сто хо́дишь в кино́?","gloss":"Tom, do you often go to the cinema?"},{"by":"a","text":"Ра́ньше ча́сто ходи́л, а сейча́с ре́дко.","gloss":"I used to go often, but now rarely."},{"by":"b","text":"А в теа́тр?","gloss":"And to the theatre?"},{"by":"a","text":"Я никогда́ не хожу́. Мне там ску́чно.","gloss":"I never go. I'm bored there."},{"by":"b","text":"А мне в теа́тре интере́сно, но я хожу́ ре́дко.","gloss":"I find the theatre interesting, but I go rarely."},{"by":"a","text":"А в кино́ ты хо́дишь?","gloss":"And do you go to the cinema?"},{"by":"b","text":"Да, два ра́за в неде́лю. Иногда́ с бра́том.","gloss":"Yes, twice a week. Sometimes with my brother."},{"by":"a","text":"Дава́й пойдём в кино́ в суббо́ту!","gloss":"Let's go to the cinema on Saturday!"}] show_gloss false practice true size 1.4 hidden true
