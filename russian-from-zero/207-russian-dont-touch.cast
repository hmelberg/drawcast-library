    dialogue talk speakers.a tom speakers.b masha turns [{"by":"a","text":"Ма́ша, входи́! Сади́сь!","gloss":"Masha, come in! Sit down!"},{"by":"b","text":"Спаси́бо. Ой, како́й гря́зный пол!","gloss":"Thank you. Oh, what a dirty floor!"},{"by":"a","text":"Нет, не сади́сь! Там кра́ска.","gloss":"No, don't sit down! There's paint there.","new":["кра́ска"]},{"by":"b","text":"Хорошо́, не бу́ду. А потоло́к вы уже́ покра́сили?","gloss":"OK, I won't. And have you painted the ceiling yet?","new":["покра́сили"]},{"by":"a","text":"Нет, за́втра. Хо́чешь покра́сить дверь?","gloss":"No, tomorrow. Do you want to paint the door?","new":["покра́сить"]},{"by":"b","text":"Да! Что ну́жно де́лать?","gloss":"Yes! What do I need to do?"},{"by":"a","text":"Вот кра́ска. Крась аккура́тно!","gloss":"Here's the paint. Paint carefully!","new":["кра́ска","аккура́тно"]},{"by":"b","text":"Че́стное сло́во, я ничего́ не уроню́!","gloss":"Word of honour, I won't drop a thing!","new":["уроню́"]}] show_gloss false practice true size 1.4 hidden true
