    text b1_cue "Could you call tomorrow?" #3d3833 x 500 y 560 font_size 54 hidden true
    dialogue talk speakers.a tom speakers.b irina turns [{"by":"a","text":"Здра́вствуйте, Ири́на! Э́то Том, рестора́н «Нева́».","gloss":"Hello, Irina! It's Tom, the Neva restaurant."},{"by":"b","text":"Здра́вствуйте, Том! Слу́шаю вас.","gloss":"Hello, Tom! I'm listening."},{"by":"a","text":"Спаси́бо за ры́бу! У меня́ ещё вопро́с.","gloss":"Thank you for the fish! I have another question."},{"by":"b","text":"Да, пожа́луйста.","gloss":"Yes, go ahead."},{"by":"a","text":"Не могли́ бы вы подтверди́ть наш зака́з на пя́тницу?","gloss":"Could you confirm our order for Friday?","new":["могли́","подтверди́ть","зака́з"]},{"by":"b","text":"Коне́чно. Ры́ба и мя́со, доста́вка в де́вять утра́.","gloss":"Of course. Fish and meat, delivery at nine in the morning.","new":["доста́вка"]},{"by":"a","text":"А мо́жно привезти́ ры́бу и в суббо́ту? Э́то сро́чно.","gloss":"And could you bring fish on Saturday too? It's urgent.","new":["сро́чно"]},{"by":"b","text":"К сожале́нию, в суббо́ту нет. Но обеща́ю: в понеде́льник бу́дет.","gloss":"Unfortunately, not on Saturday. But I promise: on Monday there will be.","new":["сожале́нию","обеща́ю"]}] show_gloss false practice true size 1.5 hidden true
    icon t_memo size 180 set twemoji x 500 y 450 or ["pencil","spiral notepad"] icon_look picture of memo hidden true
    glossed t_email "Уважа́ем[ая] Ири́на! Не могл[и́] бы вы привезти́ мя́со в понеде́льник до пят[и́]? Зара́нее спаси́бо! С уваже́ни[ем], Том" say_voice a gloss ["","","","","","","","","","","","","","","","",""] show_gloss after gloss_size 22 stress none x 500 y 440 width 860 font_size 44 hidden true
