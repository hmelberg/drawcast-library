# Came and went in Russian: пришёл, ушёл
subtitle: "Say who arrived, left, went in or out in Russian: при, у, в and вы in front of шёл and е́хал, as in пришёл, уе́хал, вошёл, вы́шел, and домо́й."
tags: ["russian","motion prefixes","пришёл","russian verbs of motion","russian grammar"]
teaches: ["grammar/motion-prefixes"]
thumb: "band \"Came, went: it's all up front\""
voices: {"a":"gemini:Achird | Tom, a warm, easy-going English speaker who knows Russian well; friendly with Masha, clear and unhurried; says Russian words the way a native Russian speaker would","b":"gemini:Leda | a friendly young Russian woman from Moscow, natural and lively, speaks English with a light Russian accent and says Russian words natively; never exaggerated"}
next: {"title":"I will read or I will finish in Russian: прочита́ю","href":"https://www.drawcast.app/#gh=hmelberg/drawcast-library/russian-from-zero/65-russian-aspect-future.cast"}

## Came and went in Russian: пришёл, ушёл
level: basic
heading: false

    shape h_wall #3d3833 shape rect x 500 y 345 width 160 height 190 style.fill #f4efe6 hidden true
    polygon h_roof #3d3833 points [[400,440],[500,530],[600,440]] style.fill #e8dfd0 hidden true
    shape h_door #3d3833 shape rect x 500 y 285 width 36 height 70 style.fill #c9b79a hidden true
    text h_name "Ма́ша" #8f887c x 500 y 560 font_size 30 hidden true
    group house members ["h_wall","h_roof","h_door","h_name"] hidden true
    icon tom_w size 120 set twemoji x 90 y 330 or ["person walking","man"] icon_look picture of "man walking" hidden true
    text t1 "Том идёт к Ма́ше." say "Том идёт к Ма́ше." x 500 y 660 font_size 56 hidden true
    text t2 "Том пришёл!" say "Том пришёл!" say_voice b x 500 y 660 font_size 60 hidden true
    text r_sh "шёл → пришёл" say "шёл, пришёл" colors {"^при":"#17808a"} x 280 y 170 font_size 46 hidden true
    text r_shla "шла → пришла́" say "шла, пришла́" colors {"^при":"#17808a"} x 720 y 170 font_size 46 hidden true
    icon car size 120 set twemoji x 690 y 330 or ["red car","oncoming automobile"] icon_look picture of automobile hidden true
    text t3 "Том прие́хал на маши́не." say "Том прие́хал на маши́не." say_voice b x 500 y 660 font_size 56 hidden true
    text r_eh "е́хал → прие́хал" say "е́хал, прие́хал" colors {"^при":"#17808a"} x 500 y 170 font_size 46 hidden true
    arrow a_pri #17808a from.x 70 from.y 400 to.x 400 to.y 400 hidden true
    text w_pri "пришёл" say пришёл colors {"^при":"#17808a"} x 235 y 450 font_size 50 hidden true
    arrow a_u #17808a from.x 600 from.y 400 to.x 930 to.y 400 hidden true
    text w_u "ушёл" say ушёл colors {"^у":"#17808a"} x 765 y 450 font_size 50 hidden true
    text t_ivan "Ива́н ушёл домо́й." say "Ива́н ушёл домо́й." say_voice b colors {"^у":"#17808a"} x 500 y 660 font_size 56 hidden true
    arrow a_v #17808a from.x 70 from.y 290 to.x 475 to.y 290 hidden true
    text w_v "вошёл" say вошёл colors {"^во":"#17808a"} x 235 y 240 font_size 50 hidden true
    text t_tomv "Том вошёл в дом." say "Том вошёл в дом." say_voice b colors {"^во":"#17808a"} x 500 y 660 font_size 56 hidden true
    arrow a_vy #17808a from.x 525 from.y 290 to.x 930 to.y 290 hidden true
    text w_vy "вы́шел" say вы́шел colors {"^вы":"#17808a"} x 765 y 240 font_size 50 hidden true
    icon cat_d size 80 set twemoji x 850 y 330 or ["cat face"] icon_look picture of cat hidden true
    text t_cat "Кот вы́шел на у́лицу." say "Кот вы́шел на у́лицу." say_voice b colors {"^вы":"#17808a"} x 500 y 660 font_size 56 hidden true
    text w_pri2 "прие́хал" say прие́хал colors {"^при":"#17808a"} x 235 y 520 font_size 40 hidden true
    text w_u2 "уе́хал" say уе́хал colors {"^у":"#17808a"} x 765 y 520 font_size 40 hidden true
    text t_hod "Вчера́ я ходи́л в кино́." say "Вчера́ я ходи́л в кино́." x 500 y 660 font_size 56 hidden true
    group board members ["a_pri","w_pri","a_u","w_u","a_v","w_v","a_vy","w_vy","w_pri2","w_u2"] hidden true
