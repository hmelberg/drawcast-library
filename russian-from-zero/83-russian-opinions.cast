    text s1b "са́мый лу́чший го́род в ми́ре." say "По-мо́ему, Москва́ — са́мый лу́чший го́род в ми́ре." say_voice b x 500 y 430 font_size 54 hidden true
    text pm_like "по-ру́сски  ·  по-мо́ему" say "по-ру́сски, по-мо́ему" colors {"^по-":"#2f6b8f"} x 500 y 360 font_size 52 hidden true
    text pm_eq "по-мо́ему  ≈  я ду́маю, что…" #8f887c x 500 y 250 font_size 40 hidden true
    text sg_m "я согла́сен" say "я согла́сен" x 250 y 560 font_size 56 hidden true
    text sg_f "я согла́сна" say "я согла́сна" say_voice b colors {"а$":"#b5482e"} x 750 y 560 font_size 56 hidden true
    text sg_p0 "мы" say "мы согла́сны" x 380 y 440 font_size 56 hidden true
    text sg_p "согла́сны" say "мы согла́сны" colors {"ы$":"#3f7f4f"} x 560 y 440 font_size 56 hidden true
    text sg_like "как свобо́ден · свобо́дна · свобо́дны" #8f887c x 500 y 340 font_size 38 hidden true
    text sg_neg "Я не согла́сен." say "Я не согла́сен." x 500 y 230 font_size 62 hidden true
    icon surprise size 120 set twemoji x 280 y 560 or ["astonished face"] icon_look picture of "face with open mouth" hidden true
    text w_pr "Пра́вда?" say Пра́вда? say_voice b x 600 y 560 font_size 80 hidden true
    text w_pr2 "Э́то пра́вда." say "Э́то пра́вда." x 600 y 450 font_size 50 hidden true
    icon thumb size 110 set twemoji x 280 y 320 or ["ok hand"] icon_look picture of "thumbs up" hidden true
    text w_kon "Коне́чно!" say Коне́чно! x 600 y 320 font_size 80 hidden true
    icon park size 120 set twemoji x 760 y 560 or ["deciduous tree","evergreen tree"] icon_look picture of "national park" hidden true
