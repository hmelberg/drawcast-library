    text s_better "Бы́ло бы лу́чше пойти́ в парк." say "Бы́ло бы лу́чше пойти́ в парк." x 450 y 480 font_size 56 hidden true
    dialogue talk speakers.a tom speakers.b masha turns [{"by":"a","text":"Ма́ша, где мы бу́дем у́жинать сего́дня?","gloss":"Masha, where shall we have dinner tonight?"},{"by":"b","text":"По-мо́ему, «Пу́шкин» — са́мый лу́чший рестора́н в Москве́.","gloss":"In my opinion, Pushkin is the best restaurant in Moscow."},{"by":"a","text":"Пра́вда? Но он са́мый дорого́й!","gloss":"Really? But it's the most expensive!"},{"by":"b","text":"Коне́чно. Но там о́чень хорошо́.","gloss":"Of course. But it's very good there."},{"by":"a","text":"Я не согла́сен. Бы́ло бы лу́чше пойти́ в кафе́.","gloss":"I don't agree. It would be better to go to a café."},{"by":"b","text":"Хорошо́, я согла́сна. Но пото́м — кино́!","gloss":"OK, I agree. But afterwards, the cinema!"},{"by":"a","text":"Коне́чно! Мы должны́ посмотре́ть но́вый фильм.","gloss":"Of course! We must see the new film."},{"by":"b","text":"Ви́дишь? Мы согла́сны!","gloss":"See? We agree!"}] practice true size 1.5 hidden true
    icon q_city size 120 set twemoji x 500 y 480 or ["city sunset"] icon_look picture of cityscape hidden true
    icon q_woman size 120 set twemoji x 380 y 480 or ["girl"] icon_look picture of woman hidden true
