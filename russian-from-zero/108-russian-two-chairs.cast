    dialogue talk speakers.a tom speakers.b masha turns [{"by":"b","text":"Том, вы́бери ла́мпу. Тебе́ нра́вится така́я?","gloss":"Tom, choose a lamp. Do you like this one?"},{"by":"a","text":"Нет, она́ сли́шком больша́я. Мне нужна́ ма́ленькая.","gloss":"No, it's too big. I need a small one."},{"by":"b","text":"Вот две ма́ленькие ла́мпы. Бе́лая и́ли чёрная?","gloss":"Here are two small lamps. White or black?"},{"by":"a","text":"Бе́лая. Я куплю́ бе́лую.","gloss":"White. I'll buy the white one."},{"by":"b","text":"А сту́лья? Тебе́ нужны́ четы́ре сту́ла?","gloss":"And chairs? Do you need four chairs?"},{"by":"a","text":"Нет, то́лько два: два удо́бных сту́ла.","gloss":"No, only two: two comfortable chairs."},{"by":"b","text":"Хорошо́. Ка́сса там. Ты покупа́ешь, а я несу́ ла́мпу!","gloss":"Good. The till is over there. You pay, and I'll carry the lamp!"},{"by":"a","text":"Спаси́бо, Ма́ша! Мы почти́ всё вы́брали.","gloss":"Thanks, Masha! We've chosen almost everything."}] show_gloss false practice true size 1.5 hidden true
