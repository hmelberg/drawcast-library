    dialogue talk speakers.a tom speakers.b masha turns [{"by":"b","text":"Ну что, ты успе́л?","gloss":"So, did you make it?"},{"by":"a","text":"Успе́л. А Со́фья уже́ всё прове́рила.","gloss":"I made it. And Sofya had already checked everything."},{"by":"b","text":"А сейча́с ты просну́лся?","gloss":"And are you awake now?","new":["просну́лся"]},{"by":"a","text":"Ещё нет. Мо́жно я немно́го посплю́?","gloss":"Not yet. Can I sleep a little?","new":["посплю́"]},{"by":"b","text":"Нет! Ты ведь шеф!","gloss":"No! You're the chef, after all!"},{"by":"a","text":"Пра́вда. Тогда́ я доде́лаю меню́ на апре́ль.","gloss":"True. Then I'll finish the April menu.","new":["доде́лаю"]},{"by":"b","text":"И не чита́й до трёх часо́в но́чи!","gloss":"And don't read until three in the morning!"},{"by":"a","text":"Хорошо́. Сего́дня я засну́ в де́сять!","gloss":"All right. Tonight I'll fall asleep at ten!","new":["засну́"]}] show_gloss false practice true size 1.4 hidden true
