    dialogue talk speakers.a tom speakers.b masha turns [{"by":"b","text":"А Ка́тя? Что она́ ещё сказа́ла?","gloss":"And Katya? What else did she say?"},{"by":"a","text":"Она́ дала́ мне сове́т: ничего́ не боя́ться.","gloss":"She gave me some advice: not to be afraid of anything.","new":["дала́"]},{"by":"b","text":"Хоро́ший сове́т! А Ди́ма подели́лся с тобо́й пла́нами?","gloss":"Good advice! And did Dima share his plans with you?","new":["подели́лся"]},{"by":"a","text":"Да. Он заяви́л, что хо́чет но́вое меню́.","gloss":"Yes. He declared that he wants a new menu.","new":["заяви́л"]},{"by":"b","text":"Неожи́данно! А ты?","gloss":"That's unexpected! And you?","new":["неожи́данно"]},{"by":"a","text":"Я сказа́л, что он прав. Он че́стный и хоро́ший по́вар.","gloss":"I said he's right. He's an honest and good cook.","new":["че́стный"]},{"by":"b","text":"К моему́ удивле́нию, тебе́ совсе́м не гру́стно.","gloss":"To my surprise, you're not sad at all.","new":["удивле́нию"]},{"by":"a","text":"Нет! Я рад. У него́ всё полу́чится.","gloss":"No! I'm glad. He'll make it work."}] show_gloss false practice true size 1.4 hidden true
