    dialogue talk speakers.a tom speakers.b masha turns [{"by":"b","text":"Том, ты кому́-нибудь говори́л, что у меня́ сего́дня день рожде́ния?","gloss":"Tom, did you tell anyone it's my birthday today?","new":["кому́-нибудь"]},{"by":"a","text":"Кое-кому́ говори́л. Не скажу́ кому́!","gloss":"I told a few people. I won't say who!","new":["кое-кому́"]},{"by":"b","text":"Ты опя́ть шу́тишь?","gloss":"Are you joking again?","new":["шу́тишь"]},{"by":"a","text":"Не шучу́. Сядь, пожа́луйста: они́ ско́ро приду́т.","gloss":"I'm not joking. Sit down, please: they'll be here soon.","new":["шучу́"]},{"by":"b","text":"Кто они́? Кто́-то из музе́я?","gloss":"Who are they? Someone from the museum?"},{"by":"a","text":"Не́которые из твои́х колле́г и кое-кто́ из ста́рых знако́мых.","gloss":"Some of your colleagues and a few old friends.","new":["не́которые","кое-кто́","знако́мых"]},{"by":"b","text":"Како́й сюрпри́з! Я так ра́да!","gloss":"What a surprise! I'm so glad!"},{"by":"a","text":"А тепе́рь — пиро́г со свеча́ми!","gloss":"And now: the pie with candles!","new":["пиро́г","свеча́ми"]}] show_gloss false practice true size 1.35 colors {"-то":"#b5532b","-нибудь":"#9c7a16","кое-":"#4a52b0"} hidden true
    icon t_memo size 180 set twemoji x 500 y 450 or ["pencil","spiral notepad"] icon_look picture of memo hidden true
