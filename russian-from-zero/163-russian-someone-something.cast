    text q_line "«У меня́ для тебя́ кое-что́ есть.»" new ["кое-что́"] colors {"кое-":"#4a52b0"} x 500 y 0 font_size 40 hidden true
    icon t_people size 110 set twemoji x 500 y 0 or ["busts in silhouette","family"] icon_look picture of "people hugging" hidden true
