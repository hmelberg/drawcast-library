    dialogue talk speakers.a tom speakers.b masha turns [{"by":"a","text":"Ма́ша, вот расписа́ние. Е́сть «Ла́сточка» и электри́чка.","gloss":"Masha, here's the timetable. There's the Lastochka and a local train.","new":["расписа́ние","электри́чка"]},{"by":"b","text":"Ива́н сказа́л, что «Ла́сточка» быстре́е.","gloss":"Ivan said the Lastochka is faster."},{"by":"a","text":"Да, почти́ два часа́. А пото́м авто́бус.","gloss":"Yes, under two hours. And then a bus."},{"by":"b","text":"Как то́лько прие́дем во Влади́мир, пойдём на авто́бус.","gloss":"As soon as we get to Vladimir, we'll go to the bus."},{"by":"a","text":"Хорошо́. А что ещё сказа́л Ива́н?","gloss":"Good. And what else did Ivan say?"},{"by":"b","text":"Он спроси́л, был ли ты в Су́здале.","gloss":"He asked whether you'd been to Suzdal."},{"by":"a","text":"Нет, не был! Како́е путеше́ствие! Переда́й Ива́ну спаси́бо.","gloss":"No, I haven't! What a trip! Say thanks to Ivan for me.","new":["путеше́ствие","Переда́й"]},{"by":"b","text":"Переда́м. И не забу́дь тёплые ве́щи: там моро́з!","gloss":"I will. And don't forget warm clothes: it's freezing there!","new":["Переда́м"]}] show_gloss false practice true size 1.4 hidden true
