    icon q_doc size 150 set twemoji x 500 y 520 or ["woman","girl"] icon_look picture of "woman health worker" hidden true
    text q_b1 "Вы должны́ принима́ть лека́рство" say "Вы должны́ принима́ть лека́рство три ра́за в день." x 500 y 340 font_size 54 hidden true
    text q_b2 "три ра́за в день." say "Вы должны́ принима́ть лека́рство три ра́за в день." x 500 y 260 font_size 54 hidden true
    text sum1 "У меня́ температу́ра и ка́шель." say "У меня́ температу́ра и ка́шель." x 500 y 560 font_size 54 hidden true
    text sum2 "принима́ть лека́рство" say "принима́ть лека́рство" x 500 y 440 font_size 54 hidden true
