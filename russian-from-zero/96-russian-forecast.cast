    dialogue talk speakers.a tom speakers.b masha turns [{"by":"a","text":"Ма́ша, како́й прогно́з на за́втра?","gloss":"Masha, what's the forecast for tomorrow?"},{"by":"b","text":"Хо́лодно! Но́чью бу́дет моро́з.","gloss":"Cold! Frost at night."},{"by":"a","text":"Ско́лько гра́дусов?","gloss":"How many degrees?"},{"by":"b","text":"Ми́нус де́сять. А днём ми́нус пять и со́лнце.","gloss":"Minus ten. And minus five in the day, and sun."},{"by":"a","text":"Е́сли бу́дет со́лнце, пойдём в парк?","gloss":"If it's sunny, shall we go to the park?"},{"by":"b","text":"Дава́й! Но бу́дет ве́тер.","gloss":"Let's! But it'll be windy."},{"by":"a","text":"Хорошо́, я бу́ду в тёплой ку́ртке.","gloss":"Fine, I'll wear a warm jacket."},{"by":"b","text":"А че́рез два дня бу́дет плюс два. Весна́!","gloss":"And in two days it'll be plus two. Spring!"}] show_gloss false practice true size 2 hidden true
    icon q_therm size 120 set twemoji x 500 y 480 or ["snowman without snow"] icon_look picture of thermometer hidden true
    icon q_snowman size 120 set twemoji x 500 y 480 or ["snowman without snow"] icon_look picture of snowman hidden true
