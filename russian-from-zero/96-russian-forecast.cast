    icon r_therm size 170 set twemoji x 500 y 450 or ["snowman without snow"] icon_look picture of thermometer hidden true
    text b_g "гра́дус · гра́дуса · гра́дусов" say "оди́н гра́дус, два гра́дуса, пять гра́дусов" colors {"а$":"#c9871a","ов$":"#2a7f7f"} x 500 y 560 font_size 54 hidden true
    text b_pm "ми́нус · плюс" say "ми́нус, плюс" x 500 y 450 font_size 50 hidden true
    text b_w "моро́з · со́лнце · ве́тер" say "моро́з, со́лнце, ве́тер" x 500 y 340 font_size 50 hidden true
