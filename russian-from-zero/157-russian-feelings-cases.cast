    dialogue talk speakers.a tom speakers.b masha turns [{"by":"b","text":"Том, я слу́шала твоё интервью́!","gloss":"Tom, I listened to your interview!"},{"by":"a","text":"Пра́вда? Я так волнова́лся в эфи́ре!","gloss":"Really? I was so nervous on air!","new":["волнова́лся"]},{"by":"b","text":"А говори́л отли́чно. Я горжу́сь тобо́й!","gloss":"But you spoke really well. I'm proud of you!","new":["горжу́сь"]},{"by":"a","text":"Спаси́бо. А Ди́ма на меня́ се́рдится.","gloss":"Thanks. But Dima is cross with me.","new":["се́рдится"]},{"by":"b","text":"Почему́ он се́рдится?","gloss":"Why is he cross?","new":["се́рдится"]},{"by":"a","text":"Я ничего́ не сказа́л о су-ше́фе!","gloss":"I didn't say a word about the sous-chef!"},{"by":"b","text":"Не волну́йся. Ди́ма до́лго не обижа́ется.","gloss":"Don't worry. Dima doesn't stay hurt for long.","new":["волну́йся","обижа́ется"]},{"by":"a","text":"Наде́юсь. За́втра я сде́лаю ему́ блины́!","gloss":"I hope so. Tomorrow I'll make him pancakes!"}] show_gloss false practice true size 1.4 hidden true
