    table drill say true new ["тетра́ди","вы́здоровеете","береги́те"] colors {"^без$":"#1a8a8a","^Без$":"#1a8a8a"} x 500 y 420 font_size 38 rows [["Ни́на Петро́вна была́ бы одна́, [е́сли бы не] Ве́ра."],["[Без] тетра́ди мы бы не зна́ли э́тих реце́птов."],["Береги́те себя́, [а то|ина́че] не вы́здоровеете."]] hidden true
    icon b_clock size 100 set twemoji x 500 y 0 or ["stopwatch"] icon_look picture of "alarm clock" hidden true
    dialogue talk speakers.a tom speakers.b masha turns [{"by":"a","text":"Ма́ша, посмотри́: тетра́дь ма́мы Ни́ны Петро́вны.","gloss":"Masha, look: Нина Петровна's mother's notebook.","new":["тетра́дь"]},{"by":"b","text":"Како́й краси́вый по́черк! А что здесь?","gloss":"What beautiful handwriting! What's in it?","new":["по́черк"]},{"by":"a","text":"Реце́пты. Е́сли бы не Ни́на Петро́вна, у нас не́ было бы э́тих пирого́в.","gloss":"Recipes. If it weren't for Нина Петровна, we wouldn't have these pies."},{"by":"b","text":"А без тебя́ она́ всю неде́лю была́ бы без обе́да.","gloss":"And without you she'd have gone without lunch all week."},{"by":"a","text":"Я про́сто приноси́л ей суп. Из ме́стных проду́ктов!","gloss":"I just brought her soup. Made from local produce!","new":["приноси́л"]},{"by":"b","text":"Ты так забо́тишься о сосе́дях!","gloss":"You take such care of your neighbours!","new":["забо́тишься"]},{"by":"a","text":"А она́ забо́тится обо мне. Говори́т: «Береги́те себя́».","gloss":"And she takes care of me. She says: «Look after yourself».","new":["береги́те","забо́тится"]},{"by":"b","text":"Пра́вильно. Береги́ себя́, а то заболе́ешь!","gloss":"Right. Look after yourself, or you'll fall ill!","new":["береги́"]}] show_gloss false practice true size 1.35 hidden true
