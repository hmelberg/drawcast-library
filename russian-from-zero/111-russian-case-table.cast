    icon ear size 180 set twemoji x 500 y 450 or ["headphone"] icon_look picture of ear hidden true
    text n1 "Э́то для тебя́ — от ма́мы." say "Э́то для тебя́ — от ма́мы." say_voice b colors {"мам[ы]":"#1a8a8a"} x 500 y 560 font_size 54 hidden true
    text n2 "Конфе́ты для Ни́ны Петро́вны." say "Конфе́ты для Ни́ны Петро́вны." say_voice b colors {"Нин[ы]":"#1a8a8a","Петровн[ы]":"#1a8a8a"} x 500 y 440 font_size 54 hidden true
    text n3 "Пойдём к ней по́сле обе́да?" say "Пойдём к ней по́сле обе́да?" colors {"обед[а]":"#1a8a8a"} x 500 y 320 font_size 54 hidden true
