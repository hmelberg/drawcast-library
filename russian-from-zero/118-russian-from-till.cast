    dialogue talk speakers.a tom speakers.b masha turns [{"by":"b","text":"Когда́ у́жин с роди́телями?","gloss":"When is dinner with your parents?"},{"by":"a","text":"В суббо́ту, по́сле семи́. Стол на четверы́х!","gloss":"On Saturday, after seven. A table for four!","new":["семи́.","четверы́х!"]},{"by":"b","text":"А в суббо́ту ты не рабо́таешь?","gloss":"And you're not working on Saturday?"},{"by":"a","text":"Нет, у меня́ выходно́й.","gloss":"No, I have a day off.","new":["выходно́й."]},{"by":"b","text":"А за́втра?","gloss":"And tomorrow?"},{"by":"a","text":"За́втра я рабо́таю с двух до десяти́.","gloss":"Tomorrow I work from two till ten.","new":["двух","десяти́."]},{"by":"b","text":"Пойдём в магази́н пе́ред рабо́той? Ку́пим что́-нибудь роди́телям.","gloss":"Shall we go to the shops before work? We'll buy something for your parents.","new":["пе́ред","рабо́той?"]},{"by":"a","text":"Пойдём! С двена́дцати до ча́са я свобо́ден.","gloss":"Let's! I'm free from twelve till one.","new":["двена́дцати","ча́са"]}] show_gloss false practice true size 1.5 hidden true
