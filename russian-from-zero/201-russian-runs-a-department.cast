    dialogue talk speakers.a tom speakers.b masha turns [{"by":"a","text":"Расскажи́ о свои́х сотру́дниках. Чем они́ увлека́ются?","gloss":"Tell me about your staff. What are they keen on?","new":["увлека́ются"]},{"by":"b","text":"Одна́ увлека́ется му́зыкой, друга́я — исто́рией.","gloss":"One is keen on music, another on history.","new":["увлека́ется"]},{"by":"a","text":"А ты? Чем ты бу́дешь занима́ться?","gloss":"And you? What will you be doing?"},{"by":"b","text":"Я бу́ду руководи́ть отде́лом и писа́ть пла́ны.","gloss":"I'll run the department and write plans."},{"by":"a","text":"Дире́ктор оцени́л рекоменда́цию твоего́ профе́ссора?","gloss":"Did the director value your professor's recommendation?","new":["Дире́ктор","оцени́л"]},{"by":"b","text":"Да, он сказа́л, что она́ о́чень хоро́шая.","gloss":"Yes, he said it was very good."},{"by":"a","text":"Я восхища́юсь тобо́й, Ма́ша. Ты э́то заслужи́ла.","gloss":"I admire you, Masha. You deserved it.","new":["восхища́юсь","заслужи́ла"]},{"by":"b","text":"Спаси́бо, Том. Ты ве́рный друг.","gloss":"Thank you, Tom. You're a true friend."}] show_gloss false practice true size 1.35 hidden true
