    dialogue talkb speakers.a tom speakers.b masha turns [{"by":"a","text":"А что э́то? Кот?","gloss":"And what's that? A cat?"},{"by":"b","text":"Не что, а кто! Э́то мой кот.","gloss":"Not what: who! That's my cat."}] size 1.4 hidden true
