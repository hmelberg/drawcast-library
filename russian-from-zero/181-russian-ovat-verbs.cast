    dialogue talk speakers.a tom speakers.b sofya turns [{"by":"a","text":"Со́фья, ты бу́дешь уча́ствовать в ко́нкурсе с на́ми?","gloss":"Sofya, will you take part in the competition with us?","new":["уча́ствовать","ко́нкурсе"]},{"by":"b","text":"В ко́нкурсе шеф-поваро́в? А кто в кома́нде?","gloss":"The chefs' competition? And who's on the team?","new":["ко́нкурсе","кома́нде"]},{"by":"a","text":"Ди́ма, ты и я. Ко́нкурс в апре́ле.","gloss":"Dima, you and me. The competition is in April.","new":["ко́нкурс"]},{"by":"b","text":"А е́сли мы проигра́ем? Э́то бу́дет ужа́сно!","gloss":"And what if we lose? That would be awful!","new":["проигра́ем"]},{"by":"a","text":"Не ду́маю. Я чу́вствую, что мы мо́жем победи́ть.","gloss":"I don't think so. I feel we can win.","new":["чу́вствую","победи́ть"]},{"by":"b","text":"Ты уве́рен на сто проце́нтов?","gloss":"Are you a hundred per cent sure?"},{"by":"a","text":"Нет, на пятьдеся́т. Но иногда́ на́до рискова́ть!","gloss":"No, fifty. But sometimes you have to take risks!","new":["рискова́ть"]},{"by":"b","text":"Хорошо́! Я уча́ствую!","gloss":"All right! I'm in!","new":["уча́ствую"]}] show_gloss false practice true size 1.4 hidden true
