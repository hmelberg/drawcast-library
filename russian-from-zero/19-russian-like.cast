    text tom_name "Tom" #8f887c x 150 y 335 font_size 32 hidden true
    icon masha size 150 set twemoji x 850 y 450 or ["girl"] icon_look picture of woman hidden true
    text masha_name "Masha" #8f887c x 850 y 335 font_size 32 hidden true
