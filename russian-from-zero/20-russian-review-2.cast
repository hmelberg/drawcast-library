    icon end_masha size 190 set twemoji x 700 y 420 or ["girl"] icon_look picture of woman hidden true
    box L11 "11.  коты́, кни́ги" say "коты́, кни́ги" width 330 height 70 radius 12 font_size 30 in grid hidden true
    box L12 "12.  но́вый, но́вая" say "но́вый, но́вая" width 330 height 70 radius 12 font_size 30 in grid hidden true
    box L13 "13.  Я хочу́ чай" say "Я хочу́ чай" width 330 height 70 radius 12 font_size 30 in grid hidden true
    box L14 "14.  Я ви́жу ма́му" say "Я ви́жу ма́му" width 330 height 70 radius 12 font_size 30 in grid hidden true
    box L15 "15.  Сего́дня суббо́та" say "Сего́дня суббо́та" width 330 height 70 radius 12 font_size 30 in grid hidden true
    box L16 "16.  Ско́лько сто́ит?" say "Ско́лько сто́ит?" width 330 height 70 radius 12 font_size 30 in grid hidden true
    box L17 "17.  Кто? Что? Когда́?" say "Кто? Что? Когда́?" width 330 height 70 radius 12 font_size 30 in grid hidden true
    box L18 "18.  был, была́" say "был, была́" width 330 height 70 radius 12 font_size 30 in grid hidden true
