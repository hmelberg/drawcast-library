    text w_les_s "Уро́к начина́ется в де́вять." say "Уро́к начина́ется в де́вять." colors {"ся$":"#b0476b"} x 500 y 370 font_size 44 hidden true
    icon w_hw_i size 100 set twemoji x 230 y 340 or ["house with garden"] icon_look picture of house hidden true
