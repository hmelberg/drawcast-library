    text p4 "Та́кже э́то хоро́ший спо́соб сде́лать го́род ти́ше." say "Та́кже э́то хоро́ший спо́соб сде́лать го́род ти́ше." colors {"^та́кже$":"#8a5fa8"} x 500 y 455 font_size 36 hidden true
    text p5 "С друго́й стороны́, не́которые лю́ди про́тив." say "С друго́й стороны́, не́которые лю́ди про́тив." colors {"^с друго́й стороны́$":"#d0865f"} x 500 y 390 font_size 36 hidden true
