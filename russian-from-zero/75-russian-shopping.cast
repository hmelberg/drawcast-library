    text q_tag "500 ₽" x 640 y 480 font_size 56 hidden true
    icon q_mirror size 120 set twemoji x 500 y 480 or ["woman"] icon_look picture of mirror hidden true
    icon q_jeans size 120 set twemoji x 500 y 480 or ["trousers"] icon_look picture of jeans hidden true
    icon q_man size 150 set twemoji x 400 y 480 or ["person"] icon_look picture of man hidden true
    icon q_coat2 size 130 set twemoji x 600 y 480 or ["womans clothes"] icon_look picture of coat hidden true
    icon q_dress size 150 set twemoji x 500 y 500 or ["shopping bag"] icon_look picture of "shopping bags" hidden true
    text q_full "Мо́жно приме́рить чёрное пла́тье?" say "Мо́жно приме́рить чёрное пла́тье?" say_voice b x 500 y 320 font_size 56 hidden true
    icon end_bag size 150 set twemoji x 500 y 500 or ["shopping bag"] icon_look picture of "shopping bags" hidden true
    text end_1 "до́рого · дёшево" x 500 y 360 font_size 46 hidden true
    text end_2 "мо́жно приме́рить? · побо́льше" colors {"^по":"#6b4fa0"} x 500 y 280 font_size 46 hidden true
