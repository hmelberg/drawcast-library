    dialogue talk speakers.a tom speakers.b masha turns [{"by":"a","text":"Приве́т, Ма́ша! Мо́жно приме́рить ку́ртку?","gloss":"Hi, Masha! Can I try on a jacket?"},{"by":"b","text":"Мо́жно. Како́й у тебя́ разме́р?","gloss":"Sure. What size are you?"},{"by":"a","text":"Пятьдеся́т. Ой, а есть побо́льше?","gloss":"Fifty. Oh, is there a bigger one?"},{"by":"b","text":"Есть. Си́ний тебе́ о́чень идёт!","gloss":"There is. Blue really suits you!"},{"by":"a","text":"Спаси́бо! А ско́лько она́ сто́ит?","gloss":"Thanks! And how much is it?"},{"by":"b","text":"Две ты́сячи рубле́й. Это дёшево!","gloss":"Two thousand roubles. That's cheap!"},{"by":"a","text":"Хорошо́! Я бы взял.","gloss":"Good! I'd take it."}] practice true size 1.4 hidden true
