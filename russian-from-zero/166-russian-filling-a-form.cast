    dialogue talk speakers.a tom speakers.b clerk turns [{"by":"b","text":"Здра́вствуйте! Вы запо́лнили заявле́ние?","gloss":"Hello! Have you filled in the application?","new":["заявле́ние"]},{"by":"a","text":"Да, вот оно́. А резюме́ ну́жно?","gloss":"Yes, here it is. And do you need a CV?"},{"by":"b","text":"Нет, резюме́ не ну́жно. Укажи́те, пожа́луйста, у́ровень.","gloss":"No, no CV is needed. Please state the level.","new":["Укажи́те","у́ровень"]},{"by":"a","text":"Пе́рвый у́ровень. А на экза́мене на́до разгова́ривать?","gloss":"The first level. And do you have to talk in the exam?","new":["у́ровень"]},{"by":"b","text":"Да, и разгова́ривать, и чита́ть, и писа́ть, и слу́шать.","gloss":"Yes: talking, reading, writing and listening."},{"by":"a","text":"Хорошо́. Я уже́ оплати́л экза́мен.","gloss":"Good. I've already paid for the exam.","new":["оплати́л"]},{"by":"b","text":"Спаси́бо, опла́чено. Подпиши́те внизу́, пожа́луйста.","gloss":"Thank you, it's paid. Please sign at the bottom.","new":["опла́чено"]},{"by":"a","text":"Вот моя́ по́дпись. До свида́ния!","gloss":"Here's my signature. Goodbye!","new":["по́дпись"]}] show_gloss false practice true size 1.4 hidden true
