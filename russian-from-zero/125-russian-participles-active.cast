    dialogue talk speakers.a d_tom speakers.b d_nina turns [{"by":"a","text":"Ни́на Петро́вна, а я могу́ взять во́ду у вхо́да?","gloss":"Nina Petrovna, can I take water at the entrance?"},{"by":"b","text":"Нет, Том. Вода́ — для жильцо́в, живу́щих с детьми́.","gloss":"No, Tom. The water is for residents living with children.","new":["живу́щих"]},{"by":"a","text":"А где мне взять во́ду?","gloss":"So where do I get water?"},{"by":"b","text":"Купи́те в магази́не. И́ли приходи́те ко мне!","gloss":"Buy some at the shop. Or come to me!"},{"by":"a","text":"Спаси́бо! А где жил Ива́н, ваш бы́вший сосе́д?","gloss":"Thank you! And where did Ivan, your former neighbour, live?","new":["бы́вший"]},{"by":"b","text":"В кварти́ре два́дцать. Тепе́рь там живу́т студе́нты, прие́хавшие из Москвы́.","gloss":"In flat twenty. Now students who came from Moscow live there.","new":["прие́хавшие"]},{"by":"a","text":"Студе́нты? Они́ говоря́т по-англи́йски?","gloss":"Students? Do they speak English?"},{"by":"b","text":"Не зна́ю. Спроси́те!","gloss":"I don't know. Ask!"}] show_gloss false practice true size 1.4 hidden true
