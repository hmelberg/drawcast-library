    dialogue talk speakers.a tom speakers.b nina turns [{"by":"a","text":"Ни́на Петро́вна, на́ше объявле́ние опублико́вано!","gloss":"Nina Petrovna, our announcement is published!","new":["опублико́вано"]},{"by":"b","text":"Я ви́дела. Его́ уже́ чита́ют все сосе́ди.","gloss":"I saw it. All the neighbours are already reading it."},{"by":"a","text":"Пра́вда? Тепе́рь о нас зна́ет весь о́стров!","gloss":"Really? Now the whole island knows about us!"},{"by":"b","text":"А прове́рка уже́ была́?","gloss":"And has the inspection been already?"},{"by":"a","text":"Была́. Мы соблюда́ем все пра́вила.","gloss":"Yes. We follow all the rules."},{"by":"b","text":"А хлеб вы берёте в магази́не?","gloss":"And do you get the bread in a shop?"},{"by":"a","text":"Нет, хлеб печётся у нас ка́ждое у́тро.","gloss":"No, the bread is baked here every morning.","new":["печётся"]},{"by":"b","text":"Тогда́ я приду́ пе́рвой. Пя́того декабря́!","gloss":"Then I'll come first. On the fifth of December!"}] show_gloss false practice true size 1.35 hidden true
