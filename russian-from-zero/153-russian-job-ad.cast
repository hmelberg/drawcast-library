    dialogue talk speakers.a tom speakers.b sofya turns [{"by":"a","text":"Здра́вствуйте, Со́фья! Я прочита́л ва́ше резюме́.","gloss":"Hello, Sofya! I've read your CV.","new":["резюме́"]},{"by":"b","text":"Здра́вствуйте! Да, я три го́да рабо́тала в Каза́ни.","gloss":"Hello! Yes, I worked in Kazan for three years."},{"by":"a","text":"Вы уме́ете гото́вить ры́бу?","gloss":"Can you cook fish?","new":["уме́ете"]},{"by":"b","text":"Да, уме́ю. И мя́со то́же.","gloss":"Yes, I can. And meat too.","new":["уме́ю"]},{"by":"a","text":"Наш гра́фик — два че́рез два. Вы мо́жете так рабо́тать?","gloss":"Our schedule is two days on, two off. Can you work like that?","new":["гра́фик"]},{"by":"b","text":"Да, могу́. А кака́я зарпла́та?","gloss":"Yes, I can. And what's the pay?","new":["зарпла́та"]},{"by":"a","text":"Се́мьдесят ты́сяч в ме́сяц. Нам ну́жен отве́тственный по́вар.","gloss":"Seventy thousand a month. We need a responsible cook.","new":["отве́тственный"]},{"by":"b","text":"Я о́чень отве́тственная. Когда́ мо́жно нача́ть?","gloss":"I'm very responsible. When can I start?","new":["отве́тственная"]}] show_gloss false practice true size 1.4 hidden true
