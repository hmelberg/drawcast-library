    dialogue talk speakers.a tom speakers.b katya turns [{"by":"a","text":"Ка́тя, ско́лько столо́в на́до накры́ть?","gloss":"Katya, how many tables do we need to lay?"},{"by":"b","text":"Шесть: пять столо́в для десяти́ челове́к и оди́н для двух.","gloss":"Six: five tables for ten people and one for two.","new":["десяти́","двух"]},{"by":"a","text":"А ча́шки и ло́жки для ко́фе?","gloss":"And cups and spoons for the coffee?","new":["ча́шки","ло́жки"]},{"by":"b","text":"Ча́шки есть, а ло́жек не хвата́ет.","gloss":"We have cups, but we're short of spoons.","new":["ча́шки","ло́жек"]},{"by":"a","text":"Я возьму́ на ку́хне. А стака́ны?","gloss":"I'll take some from the kitchen. And glasses?","new":["стака́ны"]},{"by":"b","text":"Пятьдеся́т два. Не́которые го́сти пьют то́лько сок.","gloss":"Fifty-two. Some guests drink only juice.","new":["сок"]},{"by":"a","text":"Я прове́рил коли́чество еды́: хвата́ет на всех.","gloss":"I checked the amount of food: there's enough for everyone.","new":["коли́чество","еды́"]},{"by":"b","text":"Отли́чно. Ро́вно в семь — го́сти!","gloss":"Great. Guests at seven sharp!","new":["ро́вно"]}] show_gloss false practice true size 1.4 hidden true
