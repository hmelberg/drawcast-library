    text rus_full "Росси́я — са́мая больша́я страна́ в ми́ре." say "Росси́я — са́мая больша́я страна́ в ми́ре." say_voice b colors {"ая$":"#b5482e"} x 500 y 640 font_size 42 hidden true
    text mir "мир → в ми́ре" say "мир, в ми́ре" colors {"е$":"#d0865f"} x 500 y 220 font_size 48 hidden true
