    dialogue talk speakers.a tom speakers.b masha turns [{"by":"a","text":"Ма́ша, где са́мый лу́чший рестора́н в Москве́?","gloss":"Masha, where's the best restaurant in Moscow?"},{"by":"b","text":"Тут! Мой друг Оле́г рабо́тает тут.","gloss":"Here! My friend Oleg works here."},{"by":"a","text":"Он официа́нт?","gloss":"Is he a waiter?"},{"by":"b","text":"Нет, он по́вар. Лу́чший по́вар в ми́ре!","gloss":"No, he's a cook. The best cook in the world!"},{"by":"a","text":"А что тут са́мое дорого́е?","gloss":"And what's the most expensive thing here?"},{"by":"b","text":"Мя́со. Но са́мый лу́чший — суп.","gloss":"The meat. But the best is the soup."},{"by":"a","text":"Хорошо́, я бу́ду суп.","gloss":"Fine, I'll have the soup."},{"by":"b","text":"И я! Оле́г, два су́па, пожа́луйста!","gloss":"Me too! Oleg, two soups, please!"}] practice true size 1.5 hidden true
    text chto "что → са́мое дорого́е" say "Что тут са́мое дорого́е?" colors {"ое$":"#8a5fa8"} x 500 y 600 font_size 54 hidden true
    icon q_dress size 170 set twemoji x 500 y 480 icon_look picture of dress hidden true
