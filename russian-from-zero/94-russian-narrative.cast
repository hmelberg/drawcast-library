    arrow b_axis #8f887c from.x 130 from.y 660 to.x 130 to.y 200 style.stroke_width 4 hidden true
    icon b_i1 size 90 set twemoji x 130 y 590 or ["briefcase"] icon_look picture of luggage hidden true
    icon b_i2 size 90 set twemoji x 130 y 440 or ["house"] icon_look picture of hotel hidden true
    icon b_i3 size 90 set twemoji x 130 y 290 or ["key"] icon_look picture of "old key" hidden true
