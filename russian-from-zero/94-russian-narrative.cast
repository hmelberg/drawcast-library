    text b_s2 "Пото́м я прие́хал в гости́ницу." say "Пото́м я прие́хал в гости́ницу." x 580 y 440 font_size 48 hidden true
    text b_s3 "Наконе́ц я вошёл в но́мер." say "Наконе́ц я вошёл в но́мер." x 580 y 290 font_size 48 hidden true
