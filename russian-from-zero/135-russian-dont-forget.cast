    icon ear size 180 set twemoji x 500 y 450 or ["headphone"] icon_look picture of ear hidden true
    text g_main "Ты остаёшься гла́вным." say "Ты остаёшься гла́вным." new true x 500 y 470 font_size 62 hidden true
    text g_main2 "остава́ться · to stay   гла́вный · main, in charge" #8f887c x 500 y 370 font_size 34 hidden true
