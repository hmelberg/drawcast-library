    box L31 "31.  Я чита́л, я чита́ла" say "Я чита́л, я чита́ла" width 300 height 100 radius 12 font_size 24 in grid hidden true
    box L32 "32.  Я бу́ду чита́ть" say "Я бу́ду чита́ть" width 300 height 100 radius 12 font_size 24 in grid hidden true
    box L33 "33.  Идёт снег" say "Идёт снег" width 300 height 100 radius 12 font_size 24 in grid hidden true
    box L34 "34.  В магази́не, на рабо́те" say "В магази́не, на рабо́те" width 300 height 100 radius 12 font_size 24 in grid hidden true
    box L35 "35.  Могу́, мо́жно, ну́жно" say "Могу́, мо́жно, ну́жно" width 300 height 100 radius 12 font_size 24 in grid hidden true
    box L36 "36.  Ко́фе с молоко́м" say "Ко́фе с молоко́м" width 300 height 100 radius 12 font_size 24 in grid hidden true
    box L37 "37.  У́тром, днём, ве́чером" say "У́тром, днём, ве́чером" width 300 height 100 radius 12 font_size 24 in grid hidden true
