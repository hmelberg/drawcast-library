    icon p_dep size 120 set twemoji x 170 y 340 or ["airplane"] icon_look picture of "airplane departure" hidden true
    text p_u "Че́рез неде́лю они́ улетя́т." say "Че́рез неде́лю они́ улетя́т." new ["улетя́т"] colors {"^у":"#17808a"} x 580 y 340 font_size 54 hidden true
