    dialogue talk speakers.a tom speakers.b nina turns [{"by":"b","text":"Том, за́втра прилетя́т ва́ши роди́тели?","gloss":"Tom, your parents fly in tomorrow?","new":["прилетя́т","роди́тели"]},{"by":"a","text":"Да, за́втра ве́чером. Я их жду!","gloss":"Yes, tomorrow evening. I can't wait!","new":["их"]},{"by":"b","text":"А ваш оте́ц ча́сто лета́ет?","gloss":"And does your father fly often?","new":["оте́ц","лета́ет"]},{"by":"a","text":"Да, а мать лети́т в пе́рвый раз. Она́ сама́ купи́ла биле́т!","gloss":"Yes, but Mother is flying for the first time. She bought the ticket herself!","new":["мать","лети́т"]},{"by":"b","text":"Молоде́ц! А когда́ они́ улетя́т?","gloss":"Good for her! And when do they fly home?","new":["улетя́т"]},{"by":"a","text":"Че́рез неде́лю, в воскресе́нье. Суббо́та — их после́дний день.","gloss":"In a week, on Sunday. Saturday is their last day.","new":["их","после́дний"]},{"by":"b","text":"Вы бу́дете их ждать в аэропорту́?","gloss":"Will you wait for them at the airport?","new":["их"]},{"by":"a","text":"Обяза́тельно! Я не опозда́ю.","gloss":"Without fail! I won't be late.","new":["Обяза́тельно","опозда́ю"]}] show_gloss false practice true size 1.5 hidden true
