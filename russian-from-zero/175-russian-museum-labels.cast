    dialogue talk speakers.a tom speakers.b masha turns [{"by":"a","text":"Ма́ша, како́й портре́т здесь са́мый люби́мый?","gloss":"Masha, which portrait here is the favourite?"},{"by":"b","text":"Же́нщина с кни́гой. Посети́тели её всегда́ о́чень люби́ли.","gloss":"The woman with the book. Visitors have always loved her.","new":["же́нщина","посети́тели"]},{"by":"a","text":"А кто худо́жник?","gloss":"And who is the artist?","new":["худо́жник"]},{"by":"b","text":"Мы не зна́ем. Но её фами́лию мы зна́ем: она́ писа́тель.","gloss":"We don't know. But we know her surname: she's a writer.","new":["писа́тель"]},{"by":"a","text":"А что изобража́ет вот э́та карти́на?","gloss":"And what does this picture here show?","new":["изобража́ет"]},{"by":"b","text":"Бога́того мужчи́ну с соба́кой. Соба́ку я заме́тила случа́йно, то́лько вчера́!","gloss":"A rich man with a dog. I noticed the dog by chance, only yesterday!","new":["бога́того","мужчи́ну"]},{"by":"a","text":"А э́та ча́шка — стари́нная?","gloss":"And this cup, is it antique?","new":["стари́нная"]},{"by":"b","text":"Да, эпо́ха Петра́ Пе́рвого. Посмотри́, кака́я чи́стая, как но́вая!","gloss":"Yes, the era of Peter the First. Look how clean it is, like new!","new":["эпо́ха"]}] show_gloss false practice true size 1.4 hidden true
