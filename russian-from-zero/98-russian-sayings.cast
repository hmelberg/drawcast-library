    text l1 "Том: Ма́ша, ты мне помога́ешь ка́ждый день. Спаси́бо!" say "Ма́ша, ты мне помога́ешь ка́ждый день. Спаси́бо!" x 500 y 660 font_size 34 hidden true
    text l2 "Ма́ша: Пожа́луйста! Ты мой друг." say "Пожа́луйста! Ты мой друг." say_voice b x 500 y 605 font_size 34 hidden true
    text l3 "Том: А я тебе́ ничего́ не дарю́…" say "А я тебе́ ничего́ не дарю́…" x 500 y 550 font_size 34 hidden true
    text l4 "Ма́ша: Ничего́!" say Ничего́! say_voice b x 500 y 495 font_size 34 hidden true
    glossed p5 "Не име́й сто рубле́й, а име́й сто друзе́й." say_voice b gloss ["","have","","","","have","","friends"] show_gloss under x 500 y 410 width 960 font_size 42 hidden true
    text p5_imey "име́й ≈ у меня́ есть" #8f887c say "у меня́ есть" x 500 y 270 font_size 42 hidden true
    text p5_rhyme "рубле́й · друзе́й" say "рубле́й, друзе́й" colors {"е́й$":"#1a8a8a"} x 500 y 270 font_size 46 hidden true
    icon p5_money size 100 set twemoji x 170 y 270 or ["banknote with dollar sign"] icon_look picture of "money bag" hidden true
    icon p5_friends size 110 set twemoji x 830 y 270 or ["handshake"] icon_look picture of "people hugging" hidden true
    dialogue talk speakers.a tom speakers.b masha turns [{"by":"a","text":"За́втра экза́мен, а я ещё ничего́ не сде́лал!","gloss":"The exam is tomorrow, and I haven't done anything yet!"},{"by":"b","text":"Ничего́. Лу́чше по́здно, чем никогда́!","gloss":"It's OK. Better late than never!"},{"by":"a","text":"Но я хочу́ сдать экза́мен без труда́!","gloss":"But I want to pass the exam without any work!"},{"by":"b","text":"Без труда́ не вы́тащишь и ры́бку из пруда́.","gloss":"Without work you won't pull even a little fish out of a pond."},{"by":"a","text":"Я прочита́ю всё за час!","gloss":"I'll read it all in an hour!"},{"by":"b","text":"Не на́до так. Ти́ше е́дешь — да́льше бу́дешь.","gloss":"Don't do it like that. The slower you go, the further you get."},{"by":"a","text":"Хорошо́. Уже́ по́здно, я иду́ спать.","gloss":"OK. It's late already, I'm off to bed."},{"by":"b","text":"Да! У́тро ве́чера мудрене́е.","gloss":"Yes! The morning is wiser than the evening."}] show_gloss false practice true size 1.75 hidden true
