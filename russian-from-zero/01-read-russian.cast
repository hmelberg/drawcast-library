    text g1_en "mum · in · restaurant" #2f6b8f x 370 y 508 font_size 30 hidden true
    text g2 "ТАМ СУП И ВОДА." x 370 y 420 font_size 46 hidden true
    text g2_en "there · soup · and · water" #2f6b8f x 370 y 368 font_size 30 hidden true
    text g3 "А КОТ?  НЕТ — КОТ ДОМА." x 370 y 280 font_size 46 hidden true
