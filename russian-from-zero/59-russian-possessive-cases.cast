    text r1s "к мое́й ма́ме" say "к мое́й ма́ме" colors {"ей$":"#8a5fa8","е$":"#8a5fa8"} x 735 y 530 font_size 42 hidden true
    text r2h "с мои́м бра́том" say "с мои́м бра́том" colors {"им$":"#2f6b8f","ом$":"#2f6b8f"} x 265 y 440 font_size 42 hidden true
    text r2s "с мое́й ма́мой" say "с мое́й ма́мой" colors {"ей$":"#2f6b8f","ой$":"#2f6b8f"} x 735 y 440 font_size 42 hidden true
