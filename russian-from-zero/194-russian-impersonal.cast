    dialogue talk speakers.a tom speakers.b masha turns [{"by":"b","text":"Том, а как у тебя́ дела́?","gloss":"Tom, how are things with you?"},{"by":"a","text":"Мне не спи́тся. Всё ду́маю о рестора́не.","gloss":"I can't sleep. I keep thinking about the restaurant."},{"by":"b","text":"Но́чью? Э́то плоха́я привы́чка!","gloss":"At night? That's a bad habit!"},{"by":"a","text":"Зна́ю. Но что мне де́лать?","gloss":"I know. But what am I to do?"},{"by":"b","text":"Тебе́ ну́жно отдохну́ть. Пое́здка на мо́ре!","gloss":"You need a rest. A trip to the sea!"},{"by":"a","text":"Не могу́: рабо́та. А у вас всё ещё жара́?","gloss":"I can't: work. Is it still hot there?","new":["жара́"]},{"by":"b","text":"Да. А ве́чером на не́бе звёзды и луна́.","gloss":"Yes. And in the evening there are stars and the moon in the sky.","new":["луна́"]},{"by":"a","text":"Тебе́ повезло́! А у нас всё вре́мя дождь.","gloss":"You're lucky! Here it rains all the time.","new":["повезло́"]}] show_gloss false practice true size 1.4 hidden true
