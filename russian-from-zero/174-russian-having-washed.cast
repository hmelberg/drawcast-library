    dialogue talk speakers.a tom2 speakers.b masha turns [{"by":"b","text":"Том, ты уже́ до́ма?","gloss":"Tom, are you home already?"},{"by":"a","text":"Да. Верну́вшись, я сра́зу умы́лся и переоде́лся.","gloss":"Yes. When I got back, I washed and changed at once.","new":["умы́лся","переоде́лся"]},{"by":"b","text":"Вы до́лго убира́ли ку́хню?","gloss":"Did you spend long tidying the kitchen?","new":["убира́ли"]},{"by":"a","text":"Бо́льше трёх часо́в! Мы вы́мыли плиту́ и холоди́льник.","gloss":"More than three hours! We washed the stove and the fridge.","new":["вы́мыли","плиту́","холоди́льник"]},{"by":"b","text":"А когда́ все разошли́сь?","gloss":"And when did everyone go their ways?"},{"by":"a","text":"В де́сять. Со́фья торопи́лась на по́езд.","gloss":"At ten. Sofya was hurrying for her train."},{"by":"b","text":"Она́ успе́ла во́время?","gloss":"Did she make it in time?"},{"by":"a","text":"Успе́ла! А ку́хня тепе́рь про́сто прекра́сная!","gloss":"She did! And the kitchen is simply lovely now!"}] show_gloss false practice true size 1.4 hidden true
    icon t_tree size 150 set twemoji x 500 y 450 or ["evergreen tree"] icon_look picture of "christmas tree" hidden true
    text t_gaps "Убра́[в] ку́хню и переоде́[вшись], Со́фья пое́хала на вокза́л." colors {"убра́[в]":"#8a5fa8","переоде́[вшись]":"#8a5fa8"} x 500 y 470 font_size 34 hidden true
    text q_s "Том умы́лся и сел за стол." new ["умы́лся"] x 500 y 0 font_size 40 hidden true
