    text be2 "a cheerful, many-coloured wall," #8f887c x 770 y 510 width 420 font_size 24 hidden true
    glossed b3 "Стои́т над све́тлою поля́ной." say_voice a gloss ["","","",""] show_gloss after gloss_size 18 stress none x 310 y 440 width 580 font_size 32 hidden true
    text be3 "stands above a bright clearing." #8f887c x 770 y 440 width 420 font_size 24 hidden true
    text b4 "…" #8f887c x 60 y 397 font_size 28 hidden true
    glossed b5 "Лес па́хнет ду́бом и сосно́й," say_voice a gloss ["","","","","pine"] show_gloss after gloss_size 18 stress none x 310 y 346 width 580 font_size 32 hidden true
    text be5 "The forest smells of oak and pine," #8f887c x 770 y 346 width 420 font_size 24 hidden true
    glossed b6 "За ле́то вы́сох он от со́лнца," say_voice a gloss ["","","","","",""] show_gloss after gloss_size 18 stress none x 310 y 276 width 580 font_size 32 hidden true
    text be6 "over the summer the sun dried it out," #8f887c x 770 y 276 width 420 font_size 24 hidden true
    glossed b7 "И О́сень ти́хою вдово́й" say_voice a gloss ["","","","widow"] show_gloss after gloss_size 18 stress none x 310 y 206 width 580 font_size 32 hidden true
    text be7 "and Autumn, a quiet widow," #8f887c x 770 y 206 width 420 font_size 24 hidden true
