    dialogue talk speakers.a tom speakers.b masha turns [{"by":"a","text":"Ма́ша, попро́буй суп. Как па́хнет?","gloss":"Masha, try the soup. How does it smell?"},{"by":"b","text":"За́пах отли́чный. Но со́ли мно́го.","gloss":"The smell is great. But there's a lot of salt."},{"by":"a","text":"Пра́вда? Я положи́л то́лько немно́го.","gloss":"Really? I only put in a little."},{"by":"b","text":"Том, чем бо́льше со́ли, тем ху́же!","gloss":"Tom, the more salt, the worse!"},{"by":"a","text":"Хорошо́, бу́дет ме́ньше. А ку́рица?","gloss":"All right, there'll be less. And the chicken?"},{"by":"b","text":"Ку́рица отли́чная. И по́рция больша́я!","gloss":"The chicken is excellent. And the portion is big!","new":["по́рция"]},{"by":"a","text":"Коне́чно. Здесь мо́жно хорошо́ пое́сть.","gloss":"Of course. You can eat well here.","new":["пое́сть"]},{"by":"b","text":"Тогда́ я бу́ду сюда́ ча́сто приходи́ть!","gloss":"Then I'll come here often!"}] show_gloss false practice true size 1.35 hidden true
