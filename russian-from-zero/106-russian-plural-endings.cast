    text a2 "рабо́таю с но́выми колле́гами" say "рабо́таю с но́выми колле́гами" colors {"ами$":"#2f6b8f","ыми$":"#2f6b8f"} x 500 y 450 font_size 48 hidden true
    text a3 "говорю́ о но́вых колле́гах" say "говорю́ о но́вых колле́гах" colors {"ах$":"#d0865f","ых$":"#d0865f"} x 500 y 340 font_size 48 hidden true
