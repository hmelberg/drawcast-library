    dialogue talk speakers.a tom speakers.b olga turns [{"by":"b","text":"Том, вы гото́вы? Го́сти уже́ здесь.","gloss":"Tom, are you ready? The guests are already here."},{"by":"a","text":"Да, О́льга Серге́евна! Что де́лать?","gloss":"Yes, Olga Sergeyevna! What shall I do?"},{"by":"b","text":"Свари́те суп с э́тими овоща́ми и гриба́ми.","gloss":"Make the soup with these vegetables and mushrooms."},{"by":"a","text":"Хорошо́. А где све́жие грибы́?","gloss":"Fine. And where are the fresh mushrooms?"},{"by":"b","text":"Они́ лежа́т на по́лках, ря́дом с кастрю́лями.","gloss":"They're on the shelves, next to the pots."},{"by":"a","text":"Вот суп. Попро́буйте!","gloss":"Here's the soup. Try it!"},{"by":"b","text":"О́чень вку́сно! И как бы́стро!","gloss":"Very tasty! And so quick!"},{"by":"a","text":"Спаси́бо! Я сра́зу несу́ суп гостя́м.","gloss":"Thank you! I'll take the soup to the guests right away."}] show_gloss false practice true size 1.5 hidden true
