    text d_why "«Почему́ у вас нет дете́й?»" #8f887c say "Почему́ у вас нет дете́й?" say_voice b x 500 y 390 font_size 40 hidden true
    text r_why "Она́ спроси́ла, почему́ у меня́ нет дете́й." say "Она́ спроси́ла, почему́ у меня́ нет дете́й." colors {"^почему́$":"#2f6b8f"} x 500 y 315 font_size 44 hidden true
