# I want in Russian: хочу, хочешь
subtitle: "Say what you want and what you don't in Russian, with хочу, хочешь, хочет and хотите, plus не for not and или for or, back at the café."
teaches: ["phrases/wanting"]
thumb: "band \"Tea or coffee? Neither.\" note \"хочу\""
voices: {"a":"gemini:Achird | Tom, a warm, easy-going English speaker who knows Russian well; friendly with Masha, clear and unhurried; says Russian words the way a native Russian speaker would","b":"gemini:Leda | a friendly young Russian woman from Moscow, natural and lively, speaks English with a light Russian accent and says Russian words natively; never exaggerated"}
next: {"title":"I see mum in Russian: the -у ending","href":"https://www.drawcast.app/#gh=hmelberg/drawcast-library/russian-from-zero/14-russian-see.cast"}

## I want in Russian: хочу, хочешь
level: basic

    icon tom size 140 set twemoji x 130 y 430 or ["person"] icon_look picture of man hidden true
    text tom_name "Tom" #8f887c x 130 y 320 font_size 32 hidden true
    icon masha size 140 set twemoji x 870 y 430 or ["girl"] icon_look picture of woman hidden true
    text masha_name "Masha" #8f887c x 870 y 320 font_size 32 hidden true
    group speakers members ["tom","tom_name","masha","masha_name"] hidden true
    text hook "Что вы хоти́те?" #2f6b8f say "Что вы хотите?" say_voice b x 500 y 470 font_size 72 hidden true
    dialogue talk speakers.a tom speakers.b masha turns [{"by":"b","text":"Здра́вствуйте! Что вы хоти́те?","gloss":"Hello! What would you like?"},{"by":"a","text":"Я хочу́ суп, пожа́луйста.","gloss":"I want soup, please."},{"by":"b","text":"А пить? Чай и́ли ко́фе?","gloss":"And to drink? Tea or coffee?"},{"by":"a","text":"Я не хочу́ чай. Ко́фе, пожа́луйста.","gloss":"I don't want tea. Coffee, please."},{"by":"b","text":"Хорошо́!","gloss":"Fine!"}] size 1.4 hidden true
    dialogue talk2 speakers.a tom speakers.b masha turns [{"by":"a","text":"Ма́ша, ты хо́чешь чай и́ли ко́фе?","gloss":"Masha, do you want tea or coffee?"},{"by":"b","text":"Нет, спаси́бо. Я хочу́ молоко́!","gloss":"No, thanks. I want milk!"},{"by":"a","text":"Молоко́?","gloss":"Milk?"},{"by":"b","text":"Да! Кот то́же хо́чет молоко́.","gloss":"Yes! The cat wants milk too."}] size 1.4 hidden true
    dialogue bye speakers.a tom speakers.b masha turns [{"by":"b","text":"Том, а что ты хо́чешь?","gloss":"Tom, and what do you want?"},{"by":"a","text":"Я хочу́ ко́фе! Пока́, Ма́ша!","gloss":"I want coffee! Bye, Masha!"}] size 1.4 hidden true
