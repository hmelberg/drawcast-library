    dialogue talk speakers.a tom speakers.b masha turns [{"by":"a","text":"Ма́ша, я ви́дел помеще́ние, располо́женное во́зле метро́!","gloss":"Masha, I saw premises located near the metro!","new":["помеще́ние","располо́женное","во́зле"]},{"by":"b","text":"Пра́вда? И како́е оно́?","gloss":"Really? And what's it like?"},{"by":"a","text":"Высо́кий потоло́к и подва́л, отремонти́рованный в про́шлом году́.","gloss":"A high ceiling and a basement renovated last year.","new":["потоло́к","подва́л","отремонти́рованный"]},{"by":"b","text":"Я зна́ю э́ту у́лицу! Там заво́д, постро́енный в девятна́дцатом ве́ке.","gloss":"I know that street! There's a factory there, built in the nineteenth century.","new":["заво́д","постро́енный"]},{"by":"a","text":"Да, сосе́дний дом. Но ку́хня неудо́бная, сли́шком ма́ленькая.","gloss":"Yes, the building next door. But the kitchen is awkward, too small.","new":["сосе́дний","неудо́бная"]},{"by":"b","text":"А ско́лько сто́ит аре́нда?","gloss":"And how much is the rent?","new":["аре́нда"]},{"by":"a","text":"Сто ты́сяч в ме́сяц. Э́то большо́й расхо́д.","gloss":"A hundred thousand a month. That's a big expense."},{"by":"b","text":"Большо́й. Но вдоль у́лицы магази́ны: там всегда́ лю́ди.","gloss":"Big. But there are shops along the street: there are always people there.","new":["вдоль"]}] show_gloss false practice true size 1.3 colors {"располо́женн[ое]$":"#b8860b","постро́енн[ый]$":"#b8860b","отремонти́рованн[ый]$":"#b8860b"} hidden true
    icon t_memo size 160 set twemoji x 500 y 450 or ["pencil","spiral notepad"] icon_look picture of memo hidden true
