    dialogue talk speakers.a tom speakers.b masha turns [{"by":"a","text":"Ма́ша, что здесь продаётся?","gloss":"Masha, what's sold here?","new":["продаётся"]},{"by":"b","text":"Пода́рки! Здесь мо́жно купи́ть пода́рки для всех ро́дственников.","gloss":"Presents! You can buy presents for all the relatives here."},{"by":"a","text":"А ты ча́сто ката́ешься на конька́х?","gloss":"And do you often go skating?","new":["ката́ешься","конька́х"]},{"by":"b","text":"Ка́ждую зи́му! Мы с бра́том ката́емся вме́сте и ждём друг дру́га у ка́ссы.","gloss":"Every winter! My brother and I skate together and wait for each other at the ticket office.","new":["ката́емся"]},{"by":"a","text":"Говоря́т, что ве́чером здесь о́чень мно́го наро́ду.","gloss":"They say it's very crowded here in the evening."},{"by":"b","text":"Да. Поэ́тому мы пришли́ ра́но.","gloss":"Yes. That's why we came early."},{"by":"a","text":"А ка́сса ещё откры́та? Я хочу́ ещё раз!","gloss":"Is the ticket office still open? I want another go!"},{"by":"b","text":"Откры́та. Она́ закрыва́ется в оди́ннадцать.","gloss":"It's open. It closes at eleven.","new":["закрыва́ется"]}] show_gloss false practice true size 1.5 hidden true
    icon t_ear size 180 set twemoji x 500 y 450 or ["headphone"] icon_look picture of ear hidden true
