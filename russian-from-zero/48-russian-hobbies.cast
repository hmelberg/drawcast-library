    dialogue talk speakers.a tom speakers.b masha turns [{"by":"a","text":"Ма́ша, что ты лю́бишь де́лать?","gloss":"Masha, what do you like doing?"},{"by":"b","text":"Я люблю́ му́зыку. Я игра́ю на гита́ре.","gloss":"I love music. I play the guitar."},{"by":"a","text":"А я игра́ю на пиани́но.","gloss":"And I play the piano."}] size 1.6 hidden true
    dialogue talk2 speakers.a tom speakers.b masha turns [{"by":"b","text":"А спорт? Ты игра́ешь в футбо́л?","gloss":"And sport? Do you play football?"},{"by":"a","text":"Нет, я игра́ю в те́ннис.","gloss":"No, I play tennis."},{"by":"b","text":"Я то́же! Я люблю́ те́ннис.","gloss":"Me too! I love tennis."}] size 1.6 hidden true
