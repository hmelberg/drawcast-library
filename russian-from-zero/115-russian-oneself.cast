    dialogue talk speakers.a tom speakers.b masha turns [{"by":"b","text":"Смотри́, что я себе́ купи́ла!","gloss":"Look what I bought myself!","new":["себе́"]},{"by":"a","text":"Хоро́шая ку́ртка! Ты сама́ её вы́брала?","gloss":"Nice jacket! Did you choose it yourself?","new":["сама́"]},{"by":"b","text":"Сама́! А ма́ме я везу́ конфе́ты.","gloss":"Myself! And I'm taking Mum some sweets.","new":["Сама́!"]},{"by":"a","text":"А что ты везёшь бра́ту?","gloss":"And what are you taking your brother?"},{"by":"b","text":"Кни́гу. Он лю́бит исто́рию.","gloss":"A book. He loves history."},{"by":"a","text":"За́втра пойдём в музе́й вме́сте? Вот на́ши биле́ты.","gloss":"Shall we go to the museum together tomorrow? Here are our tickets.","new":["вме́сте?"]},{"by":"b","text":"Хорошо́! Биле́ты я возьму́ с собо́й.","gloss":"Good! I'll take the tickets with me.","new":["собо́й."]},{"by":"a","text":"А по́сле музе́я — гуля́ть. Расскажу́ тебе́ о Петербу́рге!","gloss":"And after the museum, a walk. I'll tell you about Petersburg!","new":["Расскажу́"]}] show_gloss false practice true size 1.5 hidden true
