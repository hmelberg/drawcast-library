    dialogue talk speakers.a tom speakers.b tanya turns [{"by":"a","text":"Татья́на Ива́новна, я успе́л загада́ть жела́ние!","gloss":"Tatyana Ivanovna, I made my wish in time!","new":["загада́ть","жела́ние"]},{"by":"b","text":"Молоде́ц! И как хорошо́ ты тепе́рь говори́шь по-ру́сски!","gloss":"Well done! And how well you speak Russian now!"},{"by":"a","text":"С тех пор как я живу́ в Петербу́рге, я говорю́ по-ру́сски ка́ждый день.","gloss":"Since I've lived in Petersburg, I've spoken Russian every day.","new":["с","тех","пор"]},{"by":"b","text":"А Ма́ша? Ка́ждый ве́чер я не сплю, пока́ она́ не позвони́т.","gloss":"And Masha? Every evening I don't sleep until she calls.","new":["пока́"]},{"by":"a","text":"Она́ звони́т вам, как то́лько прихо́дит домо́й?","gloss":"Does she call you as soon as she gets home?","new":["то́лько"]},{"by":"b","text":"Да. А пе́ред тем как спать, пи́шет мне ещё раз.","gloss":"Yes. And before she goes to bed, she writes to me again.","new":["пе́ред"]},{"by":"a","text":"Хоро́шая дочь! А тепе́рь мо́жно шампа́нское?","gloss":"A good daughter! And may we have the champagne now?","new":["шампа́нское"]},{"by":"b","text":"Мо́жно! С Но́вым го́дом, Том!","gloss":"We may! Happy New Year, Tom!"}] show_gloss false practice true size 1.4 hidden true
