    dialogue talk speakers.a tom speakers.b masha turns [{"by":"b","text":"Том, мы на ку́хне. Сего́дня ты сва́ришь карто́шку!","gloss":"Tom, we're in the kitchen. Today you'll cook the potatoes!"},{"by":"a","text":"Хорошо́! Что я до́лжен де́лать?","gloss":"OK! What do I have to do?"},{"by":"b","text":"Наре́жь карто́шку и вари́ два́дцать мину́т.","gloss":"Cut up the potatoes and boil them for twenty minutes."},{"by":"a","text":"А пото́м?","gloss":"And then?"},{"by":"b","text":"Доба́вь ма́сло и соль. Не забу́дь соль!","gloss":"Add butter and salt. Don't forget the salt!"},{"by":"a","text":"Не забу́ду! А ты свари́ я́йца.","gloss":"I won't! And you boil the eggs."}] practice true size 1.25 hidden true
