    table t_gaps say true colors {"сидя́щ[ую]$":"#b8860b","прие́хавш[им]$":"#b8860b","игра́ющ[ем]$":"#b8860b"} x 500 y 560 font_size 38 rows [["Я зна́ю де́вушку, сидя́щ[ую]{ую,ей,ая} у окна́."],["Он говори́л с го́стем, прие́хавш[им]{им,его,ем} из Каза́ни."],["Мы ду́мали о ма́льчике, игра́ющ[ем]{ем,ему,его} под столо́м."]] hidden true
