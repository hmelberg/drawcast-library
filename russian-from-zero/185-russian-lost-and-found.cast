    table drill say true colors {"ло[сь]$":"#c9871a","ла[сь]$":"#c9871a","ит[ся]$":"#c9871a"} x 500 y 620 font_size 36 rows [["Где [нахо́дится]{нахо́дится,нашла́сь,оказа́лось,исче́з} вокза́л?"],["Меда́ль пропа́ла, но пото́м [нашла́сь]{нашла́сь,нахо́дится,оказа́лось,исче́з}."],["[Оказа́лось]{оказа́лось,нашла́сь,нахо́дится,исче́з}, что её взял Ди́ма."],["Кот был здесь, и вдруг [исче́з]{исче́з,оказа́лось,нахо́дится,нашла́сь}!"]] hidden true
    dialogue talk speakers.a tom speakers.b masha turns [{"by":"b","text":"Том, я потеря́ла кошелёк!","gloss":"Tom, I've lost my wallet!","new":["кошелёк"]},{"by":"a","text":"Где? Ты везде́ иска́ла?","gloss":"Where? Have you looked everywhere?","new":["везде́"]},{"by":"b","text":"Да, везде́. Ви́димо, я оста́вила его́ в авто́бусе.","gloss":"Yes, everywhere. Apparently I left it on the bus.","new":["везде́","Ви́димо"]},{"by":"a","text":"Позвони́ води́телю! Мо́жет быть, кошелёк нашёлся.","gloss":"Call the driver! Maybe the wallet has turned up.","new":["кошелёк","нашёлся"]},{"by":"b","text":"Я позвони́ла. Оказа́лось, что он у води́теля!","gloss":"I called. It turned out the driver has it!","new":["Оказа́лось"]},{"by":"a","text":"Отли́чно! Зна́чит, он не пропа́л.","gloss":"Great! So it isn't lost.","new":["пропа́л"]},{"by":"b","text":"Нет, не пропа́л. Води́тель ждёт меня́ на остано́вке.","gloss":"No, it isn't. The driver is waiting for me at the stop.","new":["пропа́л"]},{"by":"a","text":"Скоре́е на остано́вку! И бо́льше не теря́й его́!","gloss":"Hurry to the stop! And don't lose it again!","new":["теря́й"]}] show_gloss false practice true size 1.4 colors {"ло[сь]$":"#c9871a","ла[сь]$":"#c9871a","л[ся]$":"#c9871a","ит[ся]$":"#c9871a","ть[ся]$":"#c9871a","ти[сь]$":"#c9871a"} hidden true
