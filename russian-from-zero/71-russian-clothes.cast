    dialogue talk speakers.a tom speakers.b masha turns [{"by":"a","text":"Ма́ша, ты одева́ешься? Мы должны́ быть в кафе́ в семь.","gloss":"Masha, are you getting dressed? We have to be at the café at seven."},{"by":"b","text":"Одева́юсь! Кра́сное пла́тье и́ли си́нее?","gloss":"I'm getting dressed! The red dress or the blue one?"},{"by":"a","text":"Кра́сное! А на мне бе́лая руба́шка и чёрные брю́ки.","gloss":"The red one! And I've got a white shirt and black trousers on."},{"by":"b","text":"Хорошо́. Сего́дня хо́лодно. Где моя́ ку́ртка?","gloss":"Good. It's cold today. Where's my jacket?"},{"by":"a","text":"Зелёная? Она́ в ко́мнате.","gloss":"The green one? It's in the room."},{"by":"b","text":"Нет, кра́сная! Я бу́ду в кра́сной ку́ртке!","gloss":"No, the red one! I'll be in a red jacket!"}] practice true size 1.3 hidden true
