    table drill say true new ["дости́чь","це́ли","сле́дует","избега́ть","доверя́ет"] colors {"^цели$":"#1a8a8a","^риска$":"#1a8a8a","^плану$":"#8a5fa8","^другу$":"#8a5fa8"} x 500 y 480 font_size 46 rows [["Мы хоти́м дости́чь [це́ли]{це́ли,цель,це́лью}."],["Том всегда́ сле́дует [пла́ну]{пла́ну,пла́на,план}."],["Лу́чше избега́ть [ри́ска]{ри́ска,ри́ску,риск}."],["Ма́ша доверя́ет [дру́гу]{дру́гу,дру́га,друг}."]] hidden true
