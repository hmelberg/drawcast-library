    dialogue talk speakers.a tom speakers.b sofia turns [{"by":"b","text":"Том, дава́й посмо́трим расхо́ды. Э́то больша́я су́мма.","gloss":"Tom, let's look at the costs. It's a big sum.","new":["расхо́ды","су́мма"]},{"by":"a","text":"Да. О́льга сказа́ла, что в пе́рвый год при́были не бу́дет.","gloss":"Yes. Olga said there'll be no profit in the first year.","new":["при́были"]},{"by":"b","text":"Мы мо́жем избежа́ть э́тих расхо́дов?","gloss":"Can we avoid these costs?","new":["избежа́ть","расхо́дов"]},{"by":"a","text":"Не всех. Но я возьму́ креди́т на полови́ну су́ммы.","gloss":"Not all of them. But I'll take a loan for half the sum.","new":["креди́т","су́ммы"]},{"by":"b","text":"А насчёт нало́гов? Твоя́ фи́рма бу́дет их плати́ть.","gloss":"And what about taxes? Your firm will pay them.","new":["насчёт"]},{"by":"a","text":"Коне́чно. У меня́ есть систе́ма: я всё счита́ю ка́ждый день.","gloss":"Of course. I have a system: I count everything every day.","new":["систе́ма"]},{"by":"b","text":"Хорошо́, шеф. Я тебе́ доверя́ю.","gloss":"All right, chef. I trust you.","new":["доверя́ю"]},{"by":"a","text":"Спаси́бо. Сле́дуем пла́ну — и мы дости́гнем це́ли!","gloss":"Thank you. We follow the plan, and we'll reach our goal!","new":["Сле́дуем","дости́гнем","це́ли"]}] show_gloss false practice true size 1.35 hidden true
    icon masha size 130 set twemoji x 110 y 450 or ["girl"] icon_look picture of woman hidden true
    text masha_name "Ма́ша" #8f887c x 110 y 350 font_size 30 hidden true
    table t_gaps say true new ["дости́г","сле́дую"] colors {"^успеха$":"#1a8a8a","^совету$":"#8a5fa8"} x 500 y 480 font_size 46 rows [["Он бы́стро дости́г [успе́ха]{успе́ха,успе́ху,успе́х}."],["Я всегда́ сле́дую [сове́ту]{сове́ту,сове́та,сове́т} ма́мы."]] hidden true
