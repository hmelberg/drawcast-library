    dialogue talk speakers.a tom speakers.b masha turns [{"by":"a","text":"Приве́т, Ма́ша! Куда́ ты идёшь?","gloss":"Hi, Masha! Where are you going?"},{"by":"b","text":"Я иду́ в парк. А ты?","gloss":"I'm going to the park. And you?"},{"by":"a","text":"Я иду́ на рабо́ту.","gloss":"I'm going to work."}] size 1.6 hidden true
    dialogue talk2 speakers.a tom speakers.b masha turns [{"by":"b","text":"А за́втра?","gloss":"And tomorrow?"},{"by":"a","text":"За́втра я иду́ в кино́.","gloss":"Tomorrow I'm going to the cinema."},{"by":"b","text":"Я то́же!","gloss":"Me too!"}] size 1.6 hidden true
