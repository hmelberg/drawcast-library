    dialogue talk speakers.a tomp speakers.b masha turns [{"by":"b","text":"Том, ско́лько тут журна́лов?","gloss":"Tom, how many magazines are there here?","new":["журна́лов"]},{"by":"a","text":"Приме́рно две́сти. И газе́ты то́же.","gloss":"About two hundred. And newspapers too.","new":["газе́ты"]},{"by":"b","text":"Ни́на Петро́вна отдаёт музе́ю все свои́ журна́лы.","gloss":"Nina Petrovna is giving all her magazines to the museum.","new":["отдаёт","свои́"]},{"by":"a","text":"Да. За́втра я их несу́ в музе́й.","gloss":"Yes. Tomorrow I'm taking them to the museum."},{"by":"b","text":"Спаси́бо! А э́тот альбо́м? Его́ то́же в коро́бку?","gloss":"Thank you! And this album? Into the box too?","new":["альбо́м"]},{"by":"a","text":"Нет, э́то её со́бственный альбо́м. Она́ его́ храни́т.","gloss":"No, that's her very own album. She keeps it.","new":["со́бственный","альбо́м"]},{"by":"b","text":"Поняла́. А свои́ кни́ги она́ отда́ст вну́чке?","gloss":"I see. And her books she'll give to her granddaughter?","new":["свои́","отда́ст"]},{"by":"a","text":"Да. Она́ пыта́ется сохрани́ть па́мять о семье́.","gloss":"Yes. She's trying to keep the memory of the family.","new":["пыта́ется","сохрани́ть"]}] show_gloss false practice true size 1.4 hidden true
