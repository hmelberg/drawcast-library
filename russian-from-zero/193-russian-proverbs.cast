    dialogue talk speakers.a tomp speakers.b masha turns [{"by":"b","text":"Ну что, Том, ты реши́л? Со́бственный рестора́н и́ли нет?","gloss":"So, Tom, have you decided? A restaurant of your own or not?"},{"by":"a","text":"Ещё нет. Но под лежа́чий ка́мень вода́ не течёт!","gloss":"Not yet. But water doesn't flow under a lying stone!","new":["лежа́чий","ка́мень","течёт"]},{"by":"b","text":"Ты сего́дня как Ни́на Петро́вна!","gloss":"You're like Nina Petrovna today!"},{"by":"a","text":"Да, э́то её посло́вица. У неё посло́вицы на всё.","gloss":"Yes, it's her proverb. She has a proverb for everything."},{"by":"b","text":"А ты не бои́шься? Твоя́ иде́я — большо́й риск.","gloss":"And aren't you afraid? Your idea is a big risk."},{"by":"a","text":"Бою́сь. Но не бо́ги горшки́ обжига́ют.","gloss":"I am. But it isn't gods who fire the pots.","new":["бо́ги","горшки́","обжига́ют"]},{"by":"b","text":"Пра́вильно. Ты сме́лый, Том.","gloss":"Quite right. You're brave, Tom.","new":["сме́лый"]},{"by":"a","text":"И́ли глу́пый! Но спаси́бо.","gloss":"Or stupid! But thank you.","new":["глу́пый"]}] show_gloss false practice true size 1.4 hidden true
