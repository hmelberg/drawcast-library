    dialogue talk speakers.a tom speakers.b masha turns [{"by":"a","text":"Расскажи́те о себе́. Кака́я у вас специа́льность?","gloss":"Tell me about yourself. What did you study?","new":["специа́льность"]},{"by":"b","text":"Исто́рия иску́сства. Ещё я зако́нчила ку́рсы экскурсово́дов.","gloss":"History of art. I also did a course for tour guides.","new":["ку́рсы"]},{"by":"a","text":"Каки́е у вас бы́ли обя́занности в музе́е?","gloss":"What were your duties at the museum?","new":["обя́занности"]},{"by":"b","text":"Я гото́вила экску́рсии для дете́й и писа́ла этике́тки.","gloss":"I prepared tours for children and wrote labels."},{"by":"a","text":"А чему́ вы там научи́лись?","gloss":"And what did you learn there?","new":["научи́лись"]},{"by":"b","text":"Я научи́лась рабо́тать с детьми́ и с компью́тером.","gloss":"I learnt to work with children and with a computer.","new":["научи́лась","компью́тером"]},{"by":"a","text":"Почему́ вы хоти́те руководи́ть отде́лом?","gloss":"Why do you want to run the department?","new":["отде́лом"]},{"by":"b","text":"Моя́ профе́ссия — экскурсово́д. И я люблю́ рабо́тать с детьми́!","gloss":"My profession is tour guide. And I love working with children!","new":["профе́ссия"]}] show_gloss false practice true size 1.35 hidden true
    icon t_phone size 160 set twemoji x 500 y 470 or ["telephone receiver"] icon_look picture of "mobile phone" hidden true
