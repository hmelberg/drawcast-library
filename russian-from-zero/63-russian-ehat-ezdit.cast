    text s_today "А сего́дня я е́ду на авто́бусе." say "А сего́дня я е́ду на авто́бусе." x 500 y 420 font_size 48 hidden true
    icon p_train size 120 set twemoji x 500 y 590 or ["high-speed train","locomotive"] icon_look picture of train hidden true
