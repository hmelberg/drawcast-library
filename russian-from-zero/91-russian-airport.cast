    text l1 "— Извини́те, поса́дка уже́ начина́ется?" say "— Извини́те, поса́дка уже́ начина́ется?" x 500 y 620 font_size 40 hidden true
    text l2 "— Нет. Вы́лет не в де́сять, а в оди́ннадцать." say "— Нет. Вы́лет не в де́сять, а в оди́ннадцать." say_voice b x 500 y 520 font_size 40 hidden true
    text l3 "— А когда́ поса́дка?" say "— А когда́ поса́дка?" x 500 y 420 font_size 40 hidden true
    text l4 "— Поса́дка начина́ется че́рез час." say "— Поса́дка начина́ется че́рез час." say_voice b colors {"ся$":"#7a5aa8"} x 500 y 320 font_size 40 hidden true
    icon d_bag size 100 set twemoji x 850 y 230 or ["briefcase"] icon_look picture of luggage hidden true
    dialogue talk speakers.a tom speakers.b masha turns [{"by":"b","text":"Здра́вствуйте! Покажи́те, пожа́луйста, ваш па́спорт.","gloss":"Hello! Please show me your passport."},{"by":"a","text":"Вот мой па́спорт и биле́т.","gloss":"Here's my passport and ticket."},{"by":"b","text":"Спаси́бо. У вас есть бага́ж?","gloss":"Thank you. Do you have any luggage?"},{"by":"a","text":"Да, оди́н чемода́н.","gloss":"Yes, one suitcase."},{"by":"b","text":"Хорошо́. Ваш рейс в Москву́, вы́лет в де́сять.","gloss":"Good. Your flight to Moscow leaves at ten."},{"by":"a","text":"А когда́ начина́ется поса́дка?","gloss":"And when does boarding start?"},{"by":"b","text":"Че́рез час, в де́вять.","gloss":"In an hour, at nine."},{"by":"a","text":"Спаси́бо! До свида́ния!","gloss":"Thank you! Goodbye!"}] show_gloss false practice true size 1.75 hidden true
    icon q_dep size 200 set twemoji x 500 y 470 or ["airplane"] icon_look picture of "airplane departure" hidden true
