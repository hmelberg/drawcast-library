    dialogue talk speakers.a tom speakers.b masha turns [{"by":"a","text":"Ма́ша, поздравля́ю! Кака́я ты успе́шная!","gloss":"Masha, congratulations! How successful you are!","new":["успе́шная"]},{"by":"b","text":"Не я, а кни́га! А ты ви́дел толпу́?","gloss":"Not me, the book! Did you see the crowd?"},{"by":"a","text":"Ви́дел. Все хоте́ли кни́гу с твое́й по́дписью.","gloss":"I did. Everyone wanted the book with your signature."},{"by":"b","text":"Я так волнова́лась! Всё бы́ло норма́льно?","gloss":"I was so nervous! Was everything all right?"},{"by":"a","text":"Всё бы́ло отли́чно. За́втра, наве́рное, бу́дет статья́.","gloss":"Everything was great. Tomorrow there'll probably be an article."},{"by":"b","text":"Я не люблю́ чита́ть о себе́. Расскажи́ пото́м кра́тко!","gloss":"I don't like reading about myself. Tell me briefly later!"},{"by":"a","text":"Хорошо́. А сего́дня у́жин для тебя́ беспла́тный!","gloss":"All right. And tonight dinner is free for you!"},{"by":"b","text":"Беспла́тный? Для а́втора де́тской кни́ги? Спаси́бо, шеф!","gloss":"Free? For the author of a children's book? Thanks, chef!","new":["де́тской"]}] show_gloss false practice true size 1.35 hidden true
    icon t_phone size 80 set twemoji x 230 y 470 or ["telephone receiver"] icon_look picture of "mobile phone" hidden true
    icon t_news size 100 set twemoji x 500 y 0 or ["rolled-up newspaper"] icon_look picture of newspaper hidden true
    icon t_crowd size 100 set twemoji x 500 y 0 or ["people hugging"] icon_look picture of "busts in silhouette" hidden true
