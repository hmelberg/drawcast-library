    text b1_cue "I leave for work at eight." #3d3833 x 500 y 560 font_size 56 hidden true
    dialogue talk speakers.a tom speakers.b masha turns [{"by":"a","text":"Ма́ша, во ско́лько ты встаёшь?","gloss":"Masha, what time do you get up?"},{"by":"b","text":"В семь. Буди́льник звони́т в семь, а в во́семь я ухожу́.","gloss":"At seven. The alarm goes at seven, and at eight I leave.","new":["Буди́льник","ухожу́"]},{"by":"a","text":"Так ра́но! А я ухожу́ в час.","gloss":"So early! And I leave at one.","new":["ра́но","ухожу́"]},{"by":"b","text":"Но ты весь день на рабо́те и прихо́дишь о́чень по́здно.","gloss":"But you're at work all day and you get home very late.","new":["прихо́дишь"]},{"by":"a","text":"Да. А сего́дня я уйду́ с рабо́ты то́лько в двена́дцать.","gloss":"Yes. And today I won't leave work till twelve.","new":["уйду́"]},{"by":"b","text":"Ты успе́ешь на метро́?","gloss":"Will you make it to the metro?","new":["успе́ешь"]},{"by":"a","text":"Успе́ю. А за́втра у́тром я схожу́ в магази́н.","gloss":"I will. And tomorrow morning I'll pop to the shop.","new":["Успе́ю","схожу́"]},{"by":"b","text":"Спаси́бо! Он недалеко́, в на́шем райо́не.","gloss":"Thanks! It's not far, in our area."}] show_gloss false practice true size 1.5 hidden true
    table t_gaps say true x 500 y 560 font_size 42 rows [["Ма́ша ка́ждый день [прихо́дит]{прихо́дит,пришла́} домо́й в шесть."],["Вчера́ Том [пришёл]{пришёл,прихо́дит} домо́й в час."],["Обы́чно Ве́ра [приезжа́ет]{приезжа́ет,прие́хала} к ма́ме в суббо́ту."],["Том, [сходи́]{сходи́,уходи́} в магази́н, пожа́луйста."]] hidden true
