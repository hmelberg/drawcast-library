    dialogue talk speakers.a tom speakers.b masha turns [{"by":"b","text":"Том, а ты то́же мо́жешь ходи́ть на рабо́ту пешко́м?","gloss":"Tom, could you walk to work too?","new":["пешко́м"]},{"by":"a","text":"Пешко́м далеко́. Но тепе́рь хочу́ е́здить на велосипе́де.","gloss":"On foot it's far. But now I want to cycle.","new":["Пешко́м","велосипе́де"]},{"by":"b","text":"Вме́сто того́ что́бы е́здить на метро́? Заче́м?","gloss":"Instead of taking the metro? What for?"},{"by":"a","text":"Для того́ что́бы эконо́мить на тра́нспорте.","gloss":"To save on transport.","new":["эконо́мить"]},{"by":"b","text":"Ты то́же ко́пишь на пое́здку?","gloss":"Are you saving up for a trip too?","new":["ко́пишь","пое́здку"]},{"by":"a","text":"Да, постепе́нно коплю́ на о́тпуск.","gloss":"Yes, little by little I'm saving for a holiday.","new":["коплю́"]},{"by":"b","text":"А на велосипе́де до «Невы́» далеко́?","gloss":"And is it far to «Нева» by bike?","new":["велосипе́де"]},{"by":"a","text":"Нет, два́дцать мину́т. И беспла́тно!","gloss":"No, twenty minutes. And free!","new":["беспла́тно"]}] show_gloss false practice true size 1.4 hidden true
    icon t_memo size 170 set twemoji x 500 y 450 or ["pencil","spiral notepad"] icon_look picture of memo hidden true
