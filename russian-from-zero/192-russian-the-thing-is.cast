    dialogue talk speakers.a tom speakers.b olga turns [{"by":"b","text":"Ну, Том, на что ты рассчи́тываешь?","gloss":"So, Tom, what are you counting on?","new":["рассчи́тываешь"]},{"by":"a","text":"На то, что лю́ди лю́бят хоро́шую ку́хню.","gloss":"On people loving good cooking."},{"by":"b","text":"А ты не бои́шься того́, что не бу́дет госте́й?","gloss":"And aren't you afraid there won't be any guests?"},{"by":"a","text":"Бою́сь. Но всё зави́сит от того́, како́е бу́дет меню́.","gloss":"I am. But it all depends on what the menu will be."},{"by":"b","text":"Мой сове́т: снача́ла напиши́ план.","gloss":"My advice: write a plan first.","new":["сове́т","план"]},{"by":"a","text":"Хоро́ший сове́т. Я напишу́ его́ приме́рно за ме́сяц.","gloss":"Good advice. I'll write it in about a month.","new":["сове́т"]},{"by":"b","text":"Вполне́ мо́жет быть. А когда́ ты реши́шься?","gloss":"Quite possible. And when will you make up your mind?","new":["Вполне́","реши́шься"]},{"by":"a","text":"Ско́ро. Спаси́бо, ты меня́ убеди́ла: снача́ла план!","gloss":"Soon. Thanks, you've convinced me: a plan first!","new":["убеди́ла","план"]}] show_gloss false practice true size 1.35 colors {"^от того$":"#1a8a8a","^того$":"#1a8a8a","^на то$":"#3f7d4e"} hidden true
