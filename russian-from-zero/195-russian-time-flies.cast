    dialogue talk speakers.a tom speakers.b sofya turns [{"by":"b","text":"Том, как ведёт себя́ но́вый поставщи́к?","gloss":"Tom, how is the new supplier behaving?"},{"by":"a","text":"Хорошо́. Ме́жду про́чим, он всегда́ во́время!","gloss":"Well. By the way, he's always on time!","new":["Ме́жду","про́чим"]},{"by":"b","text":"Отли́чно! А ты ви́дел мои́ но́вые очки́?","gloss":"Great! And have you seen my new glasses?","new":["очки́"]},{"by":"a","text":"Да! Тебе́ о́чень иду́т.","gloss":"Yes! They really suit you."},{"by":"b","text":"Спаси́бо. А что с тобо́й происхо́дит?","gloss":"Thanks. And what's going on with you?","new":["происхо́дит"]},{"by":"a","text":"Мне пришла́ в го́лову одна́ иде́я.","gloss":"An idea has come into my head."},{"by":"b","text":"Кака́я иде́я? Расскажи́!","gloss":"What idea? Tell me!"},{"by":"a","text":"Пото́м. Вре́мя лети́т, а у нас обе́д!","gloss":"Later. Time flies, and we have lunch to do!"}] show_gloss false practice true size 1.4 hidden true
