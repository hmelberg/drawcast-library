    text n_long "Вы давно́ здесь живёте?" say "Вы давно́ здесь живёте?" say_voice b colors {"те$":"#3d8a5a"} x 500 y 400 font_size 64 hidden true
    text n_long_g "давно́ = for a long time · здесь = here" #8f887c x 500 y 300 font_size 34 hidden true
