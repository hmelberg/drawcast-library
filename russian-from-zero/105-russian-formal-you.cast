    dialogue talk speakers.a tom speakers.b nina turns [{"by":"b","text":"Здра́вствуйте! Извини́те за беспоко́йство. Я ва́ша сосе́дка. Дава́йте познако́мимся!","gloss":"Hello! Sorry to bother you. I'm your neighbour. Let's get acquainted!"},{"by":"a","text":"Дава́йте! Меня́ зову́т Том. Я из Ло́ндона.","gloss":"Let's! My name's Tom. I'm from London."},{"by":"b","text":"О́чень прия́тно, Том. Я Ни́на Петро́вна. Вы давно́ здесь живёте?","gloss":"Very nice to meet you, Tom. I'm Nina Petrovna. Have you lived here long?"},{"by":"a","text":"Нет, то́лько три дня.","gloss":"No, only three days."},{"by":"b","text":"Так вы иностра́нец! Вы хорошо́ говори́те по-ру́сски.","gloss":"So you're a foreigner! You speak Russian well."},{"by":"a","text":"Спаси́бо! Ни́на Петро́вна, бу́дьте добры́, скажи́те, где здесь апте́ка?","gloss":"Thank you! Nina Petrovna, would you be so kind as to tell me: where's a pharmacy around here?"},{"by":"b","text":"Ря́дом, у метро́. А е́сли ну́жно, звони́те в мою́ дверь!","gloss":"Close by, at the metro. And if you need anything, ring my bell!"},{"by":"a","text":"Спаси́бо большо́е! Тепе́рь я зна́ю, где апте́ка.","gloss":"Thank you very much! Now I know where the pharmacy is."}] show_gloss false practice true size 1.35 hidden true
    table forms say true columns ["ты","вы"] colors {"шь$":"#2f6b8f","те$":"#3d8a5a"} x 500 y 400 font_size 50 rows [["живёшь","живёте"],["говори́шь","говори́те"],["скажи́","скажи́те"],["поста́вь","поста́вьте"]] hidden true
    text p_name "Ни́на Петро́вна" say "Ни́на Петро́вна" colors {"овна$":"#9a6a2f"} x 500 y 620 font_size 80 hidden true
    text p_word "о́тчество" #8f887c say о́тчество x 500 y 525 font_size 48 hidden true
    table patro say true columns ["father","son","daughter"] colors {"ович$":"#9a6a2f","овна$":"#9a6a2f","евич$":"#9a6a2f","евна$":"#9a6a2f"} x 500 y 370 font_size 48 rows [["Пётр","Петро́вич","Петро́вна"],["Серге́й","Серге́евич","Серге́евна"]] hidden true
    text p_rule "name + о́тчество + вы" #3d3833 x 500 y 215 font_size 44 hidden true
    text w_for "иностра́нец" say иностра́нец x 500 y 560 font_size 70 hidden true
    text w_for2 "иностра́нный язы́к" #8f887c say "иностра́нный язы́к" x 500 y 450 font_size 50 hidden true
    text w_kind "Бу́дьте добры́, скажи́те…" say "Бу́дьте добры́, скажи́те…" colors {"те$":"#3d8a5a"} x 500 y 320 font_size 58 hidden true
    text w_ring "звони́ → звони́те" say "звони́, звони́те" colors {"те$":"#3d8a5a"} x 500 y 200 font_size 50 hidden true
