    text w4e "Обраща́юсь к Вам." say "Обраща́юсь к Вам." new ["Обраща́юсь"] colors {"^вам$":"#8a5fa8"} x 500 y 210 font_size 52 hidden true
    text lt_head "Письмо́ владе́лице" #8f887c stress none x 500 y 650 font_size 30 hidden true
