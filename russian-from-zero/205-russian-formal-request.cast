    dialogue talk speakers.a tom speakers.b sec turns [{"by":"b","text":"О́фис Еле́ны Ви́кторовны. Слу́шаю вас.","gloss":"Elena Viktorovna's office. Hello."},{"by":"a","text":"До́брый день. Э́то Том Смит. Я отпра́вил Еле́не Ви́кторовне письмо́.","gloss":"Good afternoon. This is Tom Smith. I sent Elena Viktorovna a letter.","new":["отпра́вил"]},{"by":"b","text":"Да, мы его́ получи́ли. Она́ рассмо́трит ва́шу про́сьбу на э́той неде́ле.","gloss":"Yes, we got it. She will consider your request this week.","new":["рассмо́трит","про́сьбу"]},{"by":"a","text":"Спаси́бо. Мне ну́жно разреше́ние до пя́тницы.","gloss":"Thank you. I need the permission by Friday.","new":["разреше́ние"]},{"by":"b","text":"Вы хоти́те подписа́ть догово́р в пя́тницу?","gloss":"You want to sign the contract on Friday?","new":["догово́р"]},{"by":"a","text":"Да. А мо́жно отпра́вить вам всю информа́цию о ремо́нте?","gloss":"Yes. And may I send you all the information about the renovation?","new":["отпра́вить","информа́цию"]},{"by":"b","text":"Коне́чно. Отпра́вьте её по электро́нной по́чте.","gloss":"Of course. Send it by e-mail.","new":["Отпра́вьте"]},{"by":"a","text":"Хорошо́. Бу́ду весьма́ благода́рен за по́мощь!","gloss":"Good. I'd be most grateful for your help!","new":["весьма́","благода́рен"]}] show_gloss false practice true size 1.35 hidden true
    text t_gaps "Обраща́юсь к Вам с про́сьб[ой]{ой,у,а}. Прошу́ Вас предоста́вить информа́ци[ю]{ю,я,и}." stress none x 500 y 450 width 880 font_size 40 hidden true
    text q6_cue "I ask you to consider my request." #3d3833 x 500 y 0 font_size 40 hidden true
    text e1 "Уважа́емая …!" #b5532b say Уважа́емая x 500 y 530 font_size 46 hidden true
    text e2 "Обраща́юсь к Вам с про́сьбой." #b5532b say "Обраща́юсь к Вам с про́сьбой." new ["Обраща́юсь","про́сьбой"] x 500 y 440 font_size 46 hidden true
    text e3 "Прошу́ Вас рассмотре́ть…" #b5532b say "Прошу́ Вас рассмотре́ть…" new ["рассмотре́ть"] x 500 y 350 font_size 46 hidden true
    text e4 "Бу́ду весьма́ благода́рен." #b5532b say "Бу́ду весьма́ благода́рен." new ["весьма́","благода́рен"] x 500 y 260 font_size 46 hidden true
    text e5 "Получи́в отве́т, …" #8a5fa8 say "Получи́в отве́т, …" new ["Получи́в"] x 500 y 170 font_size 40 hidden true
    box next206 "Да́льше: я расска́зываю всё на ку́хне «Невы́»" x 500 y 350 width 780 height 130 radius 14 font_size 36 hidden true
    glossed la1 "Уважа́емая Еле́на Ви́кторовна!" gloss ["","",""] show_gloss after gloss_size 22 read_first true stress none colors {"^уважа́емая$":"#b5532b"} x 500 y 560 width 920 font_size 36 hidden true
    glossed la2 "Обраща́юсь к Вам с про́сьбой." gloss ["I turn","","","","request"] show_gloss after gloss_size 22 stress none colors {"^обраща́юсь$":"#b5532b","^к$":"#b5532b","^вам$":"#b5532b","^с$":"#b5532b","^про́сьбой":"#b5532b"} x 500 y 460 width 920 font_size 36 hidden true
    glossed la3 "Я хочу́ арендова́ть Ва́ше помеще́ние, располо́женное на пе́рвом этаже́." gloss ["","","","","","located","","",""] show_gloss after gloss_size 22 stress none colors {"^располо́женное$":"#b8860b"} x 500 y 320 width 920 font_size 36 hidden true
    glossed la4 "Прошу́ Вас рассмотре́ть мою́ про́сьбу и предоста́вить разреше́ние на ремо́нт ку́хни." gloss ["","","consider","","request","","grant","permission","","",""] show_gloss after gloss_size 22 stress none colors {"^прошу́$":"#b5532b","^вас$":"#b5532b"} x 500 y 160 width 920 font_size 36 hidden true
    glossed lb1 "Учи́тывая, что ку́хня сли́шком ма́ленькая, я хочу́ сде́лать её бо́льше." gloss ["taking into account","","","","","","","","",""] show_gloss after gloss_size 22 read_first true stress none colors {"^учи́тывая":"#2a7f86"} x 500 y 540 width 920 font_size 36 hidden true
    glossed lb2 "Получи́в Ва́ше разреше́ние, я подпишу́ догово́р аре́нды." gloss ["having received","","permission","","","contract",""] show_gloss after gloss_size 22 stress none colors {"^получи́в$":"#8a5fa8"} x 500 y 380 width 920 font_size 36 hidden true
