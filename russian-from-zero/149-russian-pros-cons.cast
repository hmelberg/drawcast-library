    dialogue talk speakers.a tom speakers.b masha turns [{"by":"a","text":"Я счита́ю, что я ещё не гото́в быть ше́фом.","gloss":"I believe I'm not ready to be head chef yet.","new":["счита́ю"]},{"by":"b","text":"Наоборо́т! У тебя́ ведь есть о́пыт.","gloss":"On the contrary! You do have experience, after all.","new":["Наоборо́т","о́пыт"]},{"by":"a","text":"Во-пе́рвых, у ше́фа ма́ло вре́мени. Во-вторы́х, э́то тру́дная рабо́та.","gloss":"Firstly, a head chef has little time. Secondly, it's hard work.","new":["Во-пе́рвых","Во-вторы́х","тру́дная"]},{"by":"b","text":"С одно́й стороны́, да. С друго́й стороны́, э́то больша́я возмо́жность.","gloss":"On the one hand, yes. On the other hand, it's a big opportunity.","new":["одно́й"]},{"by":"a","text":"А е́сли я сде́лаю оши́бку?","gloss":"And what if I make a mistake?"},{"by":"b","text":"Все де́лают оши́бки. Наприме́р, я!","gloss":"Everyone makes mistakes. Me, for example!","new":["Наприме́р"]},{"by":"a","text":"Зна́чит, на́до согласи́ться?","gloss":"So I should say yes?","new":["согласи́ться"]},{"by":"b","text":"Мне ка́жется, да. Но всё зави́сит от тебя́.","gloss":"I think so. But it all depends on you.","new":["ка́жется","зави́сит"]}] show_gloss false practice true size 1.4 hidden true
