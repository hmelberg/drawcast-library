    dialogue talk1 speakers.a tom speakers.b lena turns [{"by":"b","text":"Извини́те, тут свобо́дно?","gloss":"Excuse me, is this seat free?"},{"by":"a","text":"Да, коне́чно. Вы то́же е́дете в Москву́?","gloss":"Yes, of course. Are you going to Moscow too?"},{"by":"b","text":"Да, домо́й. Я живу́ в Москве́. А вы?","gloss":"Yes, home. I live in Moscow. And you?"},{"by":"a","text":"Меня́ зову́т Том. Я из А́нглии, из Ло́ндона.","gloss":"My name's Tom. I'm from England, from London."},{"by":"b","text":"О́чень прия́тно! Я Ле́на. Вы хорошо́ говори́те по-ру́сски!","gloss":"Nice to meet you! I'm Lena. You speak Russian well!"},{"by":"a","text":"Спаси́бо! Я изуча́ю ру́сский уже́ два го́да.","gloss":"Thank you! I've been studying Russian for two years."},{"by":"b","text":"А кем вы рабо́таете?","gloss":"And what do you do for a living?"},{"by":"a","text":"Я рабо́таю по́варом в рестора́не. А вы?","gloss":"I work as a cook in a restaurant. And you?"}] show_gloss false practice true size 1.6 hidden true
    dialogue talk2 speakers.a tom speakers.b lena turns [{"by":"b","text":"Я учу́сь в университе́те, изуча́ю англи́йский.","gloss":"I'm at university; I study English."},{"by":"a","text":"Интере́сно! А что вы лю́бите де́лать?","gloss":"Interesting! And what do you like doing?"},{"by":"b","text":"Я игра́ю в те́ннис. А вы?","gloss":"I play tennis. And you?"},{"by":"a","text":"Я то́же! По-мо́ему, те́ннис — са́мый лу́чший спорт.","gloss":"Me too! I think tennis is the best sport."},{"by":"b","text":"Согла́сна! Е́сли в суббо́ту бу́дет тепло́, пойдём игра́ть?","gloss":"Agreed! If it's warm on Saturday, shall we go and play?"},{"by":"a","text":"Коне́чно! Како́й у вас но́мер телефо́на?","gloss":"Of course! What's your phone number?"},{"by":"b","text":"Да́йте ваш телефо́н, я напишу́ свой но́мер.","gloss":"Give me your phone; I'll write my number."},{"by":"a","text":"Вот. Ой, уже́ Москва́! До встре́чи в суббо́ту!","gloss":"Here. Oh, Moscow already! See you on Saturday!"}] show_gloss false practice true size 1.6 hidden true
