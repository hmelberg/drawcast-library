    dialogue talk speakers.a tom speakers.b masha turns [{"by":"b","text":"Том, а тепе́рь я бу́ду про́тив. Ты не возража́ешь?","gloss":"Tom, now I'll be against. Do you mind?","new":["про́тив","возража́ешь"]},{"by":"a","text":"Не возража́ю. Дава́й обсу́дим!","gloss":"I don't mind. Let's discuss it!","new":["возража́ю","обсу́дим"]},{"by":"b","text":"Не́которым лю́дям нужна́ маши́на для рабо́ты.","gloss":"Some people need a car for work."},{"by":"a","text":"Мо́жно е́здить на трамва́е и́ли на велосипе́де.","gloss":"You can go by tram or by bike."},{"by":"b","text":"А е́сли дождь? Пешко́м далеко́!","gloss":"And if it rains? It's far on foot!"},{"by":"a","text":"Зато́ во́здух бу́дет чи́стый, а у́лица — безопа́сная.","gloss":"But the air will be clean, and the street safe.","new":["во́здух","безопа́сная"]},{"by":"b","text":"Ну хорошо́. Ра́ди дете́й и птиц — я за!","gloss":"All right. For the children and the birds, I'm for!","new":["Ра́ди","птиц"]},{"by":"a","text":"Вот и́менно! Тепе́рь среди́ на́ших друзе́й никто́ не про́тив.","gloss":"Exactly! Now nobody among our friends is against.","new":["среди́","про́тив"]}] show_gloss false practice true size 1.4 hidden true
