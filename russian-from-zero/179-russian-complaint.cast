    text b1_cue "I apologise to you for the cold soup." #3d3833 x 500 y 560 font_size 42 hidden true
    dialogue talk speakers.a tom speakers.b masha turns [{"by":"b","text":"Том, у меня́ жа́лоба!","gloss":"Tom, I have a complaint!","new":["жа́лоба"]},{"by":"a","text":"Жа́лоба? На что ты жа́луешься?","gloss":"A complaint? What are you complaining about?","new":["Жа́лоба","жа́луешься"]},{"by":"b","text":"В ча́шке холо́дный чай! Его́ до́лго несли́.","gloss":"There's cold tea in my cup! It took ages to come."},{"by":"a","text":"Прости́ нас! Я сейча́с испра́влю оши́бку.","gloss":"Forgive us! I'll put the mistake right now.","new":["Прости́","испра́влю"]},{"by":"b","text":"Спаси́бо. А почему́ ты не кричи́шь на официа́нта?","gloss":"Thanks. And why aren't you shouting at the waiter?","new":["кричи́шь"]},{"by":"a","text":"Шеф не кричи́т. Шеф — ве́жливый.","gloss":"A chef doesn't shout. A chef is polite.","new":["кричи́т","ве́жливый"]},{"by":"a","text":"Вот горя́чий чай. Приношу́ свои извине́ния!","gloss":"Here's hot tea. Please accept my apologies!","new":["горя́чий","Приношу́","извине́ния"]},{"by":"b","text":"Ха-ха, как в письме́! Тепе́рь я счастли́вая.","gloss":"Ha-ha, like in a letter! Now I'm happy."}] show_gloss false practice true size 1.4 hidden true
