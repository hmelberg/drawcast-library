    text reg1 "пи́шем: Приношу́ свои извине́ния." say "Приношу́ свои извине́ния." new ["Приношу́","извине́ния"] colors {"^Приношу́$":"#b5532b","^свои$":"#b5532b","^извине́ния$":"#b5532b"} x 500 y 520 font_size 42 hidden true
